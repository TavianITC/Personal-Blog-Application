@model Personal_Blog_Application.ViewModels.BlogDetailViewModel

<section id="comments" class="mt-12"
         data-comments-create-url="@Url.Action("Create", "Comments")"
         data-comments-delete-base="@Url.Action("Delete", "Comments")">
    <h2 class="font-display mb-6 tracking-tight text-[1.4rem] text-black">
        <span>Comment@(Model.Comments.Count != 1 ? "s" : "")</span>
        <span>(<span id="comments-count-num">@Model.Comments.Count</span>)</span>
    </h2>

    <!-- Comment form -->
    <form id="comment-form"
          asp-controller="Comments" asp-action="Create" method="post"
          class="mb-8 rounded-md border border-gray-200 bg-white p-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="NewComment.BlogId" />
        <input type="hidden" asp-for="NewComment.From" />

        <textarea asp-for="NewComment.Content"
                  class="leading-[1.55] min-h-[90px] w-full resize-y rounded border border-gray-200 bg-gray-50 px-4 py-3 font-sans text-[0.9rem] text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white"
                  placeholder="Share your thoughts…"
                  maxlength="1000"></textarea>
        <span asp-validation-for="NewComment.Content"
              id="comment-form-error"
              class="mt-[0.4rem] block min-h-[1em] text-[0.775rem] text-error"></span>

        <div class="mt-3 flex justify-end">
            <button type="submit" id="comment-submit"
                    class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-white transition hover:-translate-y-px hover:shadow-btn-primary-hover hover:opacity-90 active:translate-y-0 disabled:pointer-events-none disabled:opacity-50">
                Post comment
            </button>
        </div>
    </form>

    <div id="comments-empty"
         class="rounded-md border border-dashed border-gray-200 px-4 py-10 text-center text-sm text-gray-400"
         style="@(Model.Comments.Any() ? "display:none" : "")">
        No comments yet. Be the first to share your thoughts.
    </div>

    <div id="comment-list" class="flex flex-col">
        @foreach (var c in Model.Comments)
        {
            <partial name="_CommentItem" model="c" />
        }
    </div>
</section>

<!-- Delete confirmation modal (shared, configured per click) -->
<div id="comment-delete-modal"
     class="z-[1000] fixed inset-0 hidden items-center justify-center bg-black/45 p-4">
    <div class="w-full max-w-[440px] rounded-md bg-white p-8 shadow-[0_25px_60px_rgba(0,0,0,0.2)]">
        <h2 class="font-display mb-2 tracking-tight text-[1.25rem]">
            Delete this comment?
        </h2>
        <p class="mb-6 text-sm leading-relaxed text-gray-600">
            "<span id="comment-delete-snippet"></span>" will be permanently deleted.
        </p>
        <div class="flex justify-end gap-2">
            <button type="button" id="comment-delete-cancel"
                    class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-gray-600 transition hover:-translate-y-px hover:border-gray-300 hover:bg-gray-100 hover:text-black active:translate-y-0">Cancel</button>
            <button type="button" id="comment-delete-confirm"
                    class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-error px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-white transition hover:-translate-y-px hover:shadow-btn-danger-hover hover:opacity-90 active:translate-y-0">Delete</button>
        </div>
    </div>
</div>

<script>
    (function () {
        const wrap = document.getElementById('comments');
        const createUrl = wrap.getAttribute('data-comments-create-url');
        const deleteBase = wrap.getAttribute('data-comments-delete-base');

        const form = document.getElementById('comment-form');
        const textarea = document.getElementById('NewComment_Content');
        const errorEl = document.getElementById('comment-form-error');
        const submitBtn = document.getElementById('comment-submit');
        const list = document.getElementById('comment-list');
        const emptyEl = document.getElementById('comments-empty');
        const countNum = document.getElementById('comments-count-num');

        const modal = document.getElementById('comment-delete-modal');
        const snippetEl = document.getElementById('comment-delete-snippet');
        const confirmBtn = document.getElementById('comment-delete-confirm');
        const cancelBtn = document.getElementById('comment-delete-cancel');
        let pendingDeleteId = null;

        function antiForgeryToken() {
            const input = form.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        function openModal() {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        function closeModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function setCount(n) {
            countNum.textContent = n;
            emptyEl.style.display = n > 0 ? 'none' : '';
        }

        // ── Create via AJAX ───────────────────────────────────────
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            errorEl.textContent = '';
            submitBtn.disabled = true;

            try {
                const fd = new FormData(form);
                const res = await fetch(createUrl, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (res.status === 400) {
                    const data = await res.json();
                    errorEl.textContent = (data.errors && data.errors[0]) || 'Could not post comment.';
                    return;
                }
                if (!res.ok) {
                    errorEl.textContent = 'Could not post comment. Please try again.';
                    return;
                }

                const data = await res.json();
                if (data.ok && data.html) {
                    list.insertAdjacentHTML('afterbegin', data.html);
                    textarea.value = '';
                    setCount(data.count);
                }
            } catch (err) {
                errorEl.textContent = 'Network error. Please try again.';
            } finally {
                submitBtn.disabled = false;
            }
        });

        // ── Delete: open modal (event delegation) ──
        list.addEventListener('click', function (e) {
            const btn = e.target.closest('.js-delete-comment');
            if (!btn) return;
            pendingDeleteId = btn.getAttribute('data-id');
            snippetEl.textContent = btn.getAttribute('data-snippet') || '';
            openModal();
        });

        cancelBtn.addEventListener('click', () => {
            closeModal();
            pendingDeleteId = null;
        });
        modal.addEventListener('click', (e) => {
            if (e.target === modal) cancelBtn.click();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) cancelBtn.click();
        });

        // ── Delete: confirm + AJAX ────────────────────────────────
        confirmBtn.addEventListener('click', async function () {
            if (!pendingDeleteId) return;
            confirmBtn.disabled = true;

            try {
                const fd = new FormData();
                fd.append('__RequestVerificationToken', antiForgeryToken());

                const res = await fetch(deleteBase + '/' + pendingDeleteId, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (res.status === 403) {
                    alert('You are not allowed to delete this comment.');
                    return;
                }
                if (!res.ok) {
                    alert('Could not delete comment. Please try again.');
                    return;
                }

                const data = await res.json();
                if (data.ok) {
                    const node = list.querySelector('[data-comment-id="' + pendingDeleteId + '"]');
                    if (node) node.remove();
                    setCount(data.count);
                }
            } catch (err) {
                alert('Network error. Please try again.');
            } finally {
                confirmBtn.disabled = false;
                closeModal();
                pendingDeleteId = null;
            }
        });
    })();
</script>
