@model Personal_Blog_Application.ViewModels.BlogDetailViewModel

<style>
    .comments-wrap {
        margin-top: 3rem;
    }

    .comments-title {
        font-family: var(--font-display);
        font-size: 1.4rem;
        letter-spacing: -0.02em;
        margin-bottom: 1.5rem;
        color: var(--black);
    }

    .comments-form {
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        padding: 1.25rem;
        margin-bottom: 2rem;
    }

    .comments-textarea {
        width: 100%;
        min-height: 90px;
        padding: 0.75rem 1rem;
        font-family: var(--font-body);
        font-size: 0.9rem;
        line-height: 1.55;
        color: var(--black);
        background: var(--gray-50);
        border: 1px solid var(--gray-200);
        border-radius: var(--radius);
        outline: none;
        resize: vertical;
        transition: border-color var(--transition), background var(--transition);
    }

        .comments-textarea:focus {
            border-color: var(--black);
            background: var(--white);
        }

        .comments-textarea::placeholder {
            color: var(--gray-400);
        }

    .comments-form-error {
        display: block;
        font-size: 0.775rem;
        color: var(--error);
        margin-top: 0.4rem;
        min-height: 1em;
    }

    .comments-form-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.75rem;
    }

    .comments-empty {
        text-align: center;
        padding: 2.5rem 1rem;
        color: var(--gray-400);
        font-size: 0.875rem;
        border: 1px dashed var(--gray-200);
        border-radius: var(--radius-md);
    }

    .comment-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .comment-item {
        display: flex;
        gap: 0.85rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--gray-100);
        animation: comment-fade-in 0.25s ease-out;
    }

        .comment-item:last-child {
            border-bottom: none;
        }

    @@keyframes comment-fade-in {
        from { opacity: 0; transform: translateY(-4px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .comment-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--gray-200);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-600);
        flex-shrink: 0;
    }

    .comment-body {
        flex: 1;
        min-width: 0;
    }

    .comment-meta {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.78rem;
        color: var(--gray-600);
        margin-bottom: 0.3rem;
    }

        .comment-meta strong {
            font-weight: 500;
            color: var(--black);
        }

        .comment-meta .dot {
            color: var(--gray-400);
        }

    .comment-content {
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--gray-800);
        margin: 0;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .comment-delete {
        margin-left: auto;
        padding: 0.25rem 0.4rem;
        background: transparent;
        border: none;
        border-radius: var(--radius);
        color: var(--gray-400);
        cursor: pointer;
        opacity: 0;
        transition: opacity var(--transition), background var(--transition), color var(--transition);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .comment-item:hover .comment-delete,
    .comment-item:focus-within .comment-delete {
        opacity: 1;
    }

    .comment-delete:hover {
        background: #fef2f2;
        color: var(--error);
    }

    .comment-delete svg {
        width: 14px;
        height: 14px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
</style>

<section id="comments" class="comments-wrap"
         data-comments-create-url="@Url.Action("Create", "Comments")"
         data-comments-delete-base="@Url.Action("Delete", "Comments")">
    <h2 class="comments-title">
        <span>Comment@(Model.Comments.Count != 1 ? "s" : "")</span>
        <span class="comments-count">(<span id="comments-count-num">@Model.Comments.Count</span>)</span>
    </h2>

    <!-- Comment form -->
    <form id="comment-form"
          asp-controller="Comments" asp-action="Create" method="post"
          class="comments-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="NewComment.BlogId" />
        <input type="hidden" asp-for="NewComment.From" />

        <textarea asp-for="NewComment.Content"
                  class="comments-textarea"
                  placeholder="Share your thoughts…"
                  maxlength="1000"></textarea>
        <span asp-validation-for="NewComment.Content" class="comments-form-error"
              id="comment-form-error"></span>

        <div class="comments-form-actions">
            <button type="submit" class="btn btn-primary btn-sm" id="comment-submit">
                Post comment
            </button>
        </div>
    </form>

    <div id="comments-empty"
         class="comments-empty"
         style="@(Model.Comments.Any() ? "display:none" : "")">
        No comments yet. Be the first to share your thoughts.
    </div>

    <div id="comment-list" class="comment-list">
        @foreach (var c in Model.Comments)
        {
            <partial name="_CommentItem" model="c" />
        }
    </div>
</section>

<!-- Delete confirmation modal (shared, configured per click) -->
<div id="comment-delete-modal"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);
            z-index:1000;align-items:center;justify-content:center;padding:1rem">
    <div style="background:#fff;border-radius:6px;max-width:440px;width:100%;
                padding:2rem;box-shadow:0 25px 60px rgba(0,0,0,0.2)">
        <h2 style="font-family:var(--font-display);font-size:1.25rem;
                   letter-spacing:-0.02em;margin-bottom:0.5rem">
            Delete this comment?
        </h2>
        <p style="font-size:0.875rem;color:var(--gray-600);margin-bottom:1.5rem;line-height:1.6">
            "<span id="comment-delete-snippet"></span>" will be permanently deleted.
        </p>
        <div style="display:flex;justify-content:flex-end;gap:0.5rem">
            <button type="button" id="comment-delete-cancel" class="btn btn-ghost btn-sm">Cancel</button>
            <button type="button" id="comment-delete-confirm" class="btn btn-danger btn-sm">Delete</button>
        </div>
    </div>
</div>

<script>
    (function () {
        const wrap = document.getElementById('comments');
        const createUrl = wrap.getAttribute('data-comments-create-url');
        const deleteBase = wrap.getAttribute('data-comments-delete-base');

        const form = document.getElementById('comment-form');
        const textarea = document.getElementById('NewComment_Content');
        const errorEl = document.getElementById('comment-form-error');
        const submitBtn = document.getElementById('comment-submit');
        const list = document.getElementById('comment-list');
        const emptyEl = document.getElementById('comments-empty');
        const countNum = document.getElementById('comments-count-num');

        const modal = document.getElementById('comment-delete-modal');
        const snippetEl = document.getElementById('comment-delete-snippet');
        const confirmBtn = document.getElementById('comment-delete-confirm');
        const cancelBtn = document.getElementById('comment-delete-cancel');
        let pendingDeleteId = null;

        function antiForgeryToken() {
            const input = form.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        function setCount(n) {
            countNum.textContent = n;
            emptyEl.style.display = n > 0 ? 'none' : '';
        }

        // ── Create via AJAX ───────────────────────────────────────
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            errorEl.textContent = '';
            submitBtn.disabled = true;

            try {
                const fd = new FormData(form);
                const res = await fetch(createUrl, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (res.status === 400) {
                    const data = await res.json();
                    errorEl.textContent = (data.errors && data.errors[0]) || 'Could not post comment.';
                    return;
                }
                if (!res.ok) {
                    errorEl.textContent = 'Could not post comment. Please try again.';
                    return;
                }

                const data = await res.json();
                if (data.ok && data.html) {
                    list.insertAdjacentHTML('afterbegin', data.html);
                    textarea.value = '';
                    setCount(data.count);
                }
            } catch (err) {
                errorEl.textContent = 'Network error. Please try again.';
            } finally {
                submitBtn.disabled = false;
            }
        });

        // ── Delete: open modal (event delegation so dynamically-added comments work) ──
        list.addEventListener('click', function (e) {
            const btn = e.target.closest('.js-delete-comment');
            if (!btn) return;
            pendingDeleteId = btn.getAttribute('data-id');
            snippetEl.textContent = btn.getAttribute('data-snippet') || '';
            modal.style.display = 'flex';
        });

        cancelBtn.addEventListener('click', () => {
            modal.style.display = 'none';
            pendingDeleteId = null;
        });
        modal.addEventListener('click', (e) => {
            if (e.target === modal) cancelBtn.click();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.style.display === 'flex') cancelBtn.click();
        });

        // ── Delete: confirm + AJAX ────────────────────────────────
        confirmBtn.addEventListener('click', async function () {
            if (!pendingDeleteId) return;
            confirmBtn.disabled = true;

            try {
                const fd = new FormData();
                fd.append('__RequestVerificationToken', antiForgeryToken());

                const res = await fetch(deleteBase + '/' + pendingDeleteId, {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (res.status === 403) {
                    alert('You are not allowed to delete this comment.');
                    return;
                }
                if (!res.ok) {
                    alert('Could not delete comment. Please try again.');
                    return;
                }

                const data = await res.json();
                if (data.ok) {
                    const node = list.querySelector('[data-comment-id="' + pendingDeleteId + '"]');
                    if (node) node.remove();
                    setCount(data.count);
                }
            } catch (err) {
                alert('Network error. Please try again.');
            } finally {
                confirmBtn.disabled = false;
                modal.style.display = 'none';
                pendingDeleteId = null;
            }
        });
    })();
</script>
