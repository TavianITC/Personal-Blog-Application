@model Personal_Blog_Application.Models.Blog

@*
    Reusable summary card used by Posts (community feed) and Home logged-in feed.
    The whole card is a single <a> linking to Detail.

    Options via ViewData:
    - "Compact" (bool)         — smaller variant (Home feed). Defaults to false.
    - "ShowStatusPill" (bool)  — render DRAFT/PRIVATE/PUBLISHED pill. Defaults to false.
    - "ExcerptLength" (int)    — truncate length for excerpt. Defaults to 180.
    - "From" (string)          — forwarded as ?from= on the Detail link.
*@
@{
    var compact = ViewData["Compact"] as bool? ?? false;
    var showStatusPill = ViewData["ShowStatusPill"] as bool? ?? false;
    var excerptLength = ViewData["ExcerptLength"] as int? ?? 180;
    var from = ViewData["From"] as string;

    var authorName = Model.User?.UserName ?? "Unknown";
    var commentCount = Model.Comments?.Count ?? 0;

    var wrapperClass = compact
        ? "relative flex flex-col bg-white border border-gray-200 rounded-md p-6 text-inherit no-underline transition hover:border-gray-400 hover:-translate-y-0.5 hover:text-inherit hover:no-underline"
        : "relative flex flex-col bg-white border border-gray-200 rounded-md p-7 text-inherit no-underline transition hover:border-gray-400 hover:-translate-y-0.5 hover:text-inherit hover:no-underline";

    var headerClass = compact
        ? "flex items-center gap-2 mb-[0.85rem]"
        : "flex items-center gap-[0.6rem] mb-4";

    var avatarSize = compact ? "h-[30px] w-[30px]" : "h-8 w-8";

    var metaClass = compact
        ? "text-[0.75rem] text-gray-600 flex-1 whitespace-nowrap overflow-hidden text-ellipsis"
        : "text-[0.775rem] text-gray-600 flex-1 whitespace-nowrap overflow-hidden text-ellipsis";

    var titleClass = compact
        ? "font-display text-[1.05rem] leading-[1.35] tracking-[-0.015em] text-black mb-[0.45rem]"
        : "font-display text-[1.3rem] leading-tight tracking-tight text-black mb-[0.6rem]";

    var excerptClass = compact
        ? "text-[0.825rem] text-gray-600 leading-[1.6] m-0 overflow-hidden flex-1 [display:-webkit-box] [-webkit-line-clamp:2] [-webkit-box-orient:vertical]"
        : "text-sm text-gray-600 leading-[1.65] m-0 overflow-hidden flex-1 [display:-webkit-box] [-webkit-line-clamp:3] [-webkit-box-orient:vertical]";

    var badgeBase = compact
        ? "inline-flex items-center text-[0.65rem] font-medium px-2 py-[0.2rem] rounded-full flex-shrink-0"
        : "inline-flex items-center text-[0.7rem] font-medium px-[0.6rem] py-1 rounded-full flex-shrink-0";

    string PriorityBadgeColors(int p) => p switch
    {
        5 => "bg-black text-white",
        4 => "bg-gray-800 text-white",
        3 => "bg-gray-200 text-black",
        2 => "bg-gray-100 text-gray-600",
        _ => "bg-gray-50 text-gray-400"
    };

    var commentsClass = compact
        ? "inline-flex items-center gap-1 text-[0.65rem] font-medium px-2 py-[0.2rem] rounded-full bg-gray-100 text-gray-600 flex-shrink-0"
        : "inline-flex items-center gap-1 text-[0.7rem] font-medium px-2 py-1 rounded-full bg-gray-100 text-gray-600 flex-shrink-0";

    var svgClass = compact
        ? "w-[11px] h-[11px] stroke-current fill-none"
        : "w-3 h-3 stroke-current fill-none";
}

<a class="@wrapperClass"
   asp-controller="Blogs" asp-action="Detail"
   asp-route-id="@Model.Id" asp-route-from="@from">
    <div class="@headerClass">
        <partial name="_Avatar" model="@(new Personal_Blog_Application.ViewModels.AvatarRenderViewModel { AvatarUrl = Model.User?.AvatarUrl, UserName = authorName, SizeClasses = avatarSize })" />
        <span class="@metaClass">
            <strong class="font-medium text-black">@authorName</strong>
            <span class="mx-[0.35rem] text-gray-400">·</span>
            @ViewHelpers.RelativeTime(Model.CreatedAt)
        </span>

        @if (showStatusPill)
        {
            if (Model.Status == "DRAFT")
            {
                <span class="inline-flex flex-shrink-0 items-center rounded-full bg-draft-bg px-2 py-[0.18rem] font-medium uppercase tracking-wider text-[0.65rem] text-draft-text">Draft</span>
            }
            else if (Model.Status == "PRIVATE")
            {
                <span class="inline-flex flex-shrink-0 items-center rounded-full bg-private-bg px-2 py-[0.18rem] font-medium uppercase tracking-wider text-[0.65rem] text-private-text">Private</span>
            }
            else if (Model.Status == "PUBLISHED")
            {
                <span class="inline-flex flex-shrink-0 items-center rounded-full bg-published-bg px-2 py-[0.18rem] font-medium uppercase tracking-wider text-[0.65rem] text-published-text">Published</span>
            }
        }

        @if (commentCount > 0)
        {
            <span class="@commentsClass" title="@commentCount comment@(commentCount != 1 ? "s" : "")">
                <svg class="@svgClass" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
                </svg>
                @commentCount
            </span>
        }

        <span class="@badgeBase @PriorityBadgeColors(Model.Priority)">P@(Model.Priority)</span>
    </div>

    <div class="@titleClass">@Model.Title</div>
    <p class="@excerptClass">@ViewHelpers.Excerpt(Model.Content, excerptLength)</p>
</a>
