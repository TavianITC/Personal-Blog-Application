@{
    var avatarUrl = ViewBag.AvatarUrl as string;
    var userName = User.Identity?.Name ?? "U";
    var initial = userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Blog</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
</head>
<body class="m-0 bg-gray-50 p-0 font-sans text-black antialiased">

    <!-- ── Navbar ── -->
    <nav class="z-[100] sticky top-0 flex h-nav items-center border-b border-gray-200 bg-white/90 backdrop-blur-md">
        <div class="max-w-content mx-auto flex w-full items-center justify-between px-8">
            <a asp-controller="Home" asp-action="Index"
               class="font-display tracking-tight text-[1.4rem] text-black no-underline hover:text-black">
                Tavian Blog
            </a>

            <div class="hidden items-center gap-1 sm:flex">
                @if (User.Identity!.IsAuthenticated)
                {
                    <a class="rounded px-3 py-[0.4rem] font-normal text-[0.85rem] text-gray-600 no-underline transition hover:bg-gray-100 hover:text-black"
                       asp-controller="Blogs" asp-action="Index">Posts</a>
                    <a class="rounded px-3 py-[0.4rem] font-normal text-[0.85rem] text-gray-600 no-underline transition hover:bg-gray-100 hover:text-black"
                       asp-controller="Blogs" asp-action="Mine">My Blogs</a>

                    @if (User.IsInRole("ADMIN"))
                    {
                        <a class="rounded px-3 py-[0.4rem] font-normal text-[0.85rem] text-gray-600 no-underline transition hover:bg-gray-100 hover:text-black"
                           asp-controller="Users" asp-action="Index">Users</a>
                    }

                    <div class="relative ml-2 flex items-center gap-3">
                        <button id="avatarToggle" class="flex cursor-pointer items-center border-0 bg-none p-0"
                                aria-expanded="false" aria-label="Open profile menu">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img class="h-8 w-8 rounded-full border border-gray-200 object-cover" src="@avatarUrl" alt="@userName" />
                            }
                            else
                            {
                                <div class="flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 bg-gray-200 font-medium text-[0.75rem] text-gray-600">@initial</div>
                            }
                        </button>
                        <span class="font-medium text-[0.85rem] text-black">@userName</span>

                        <div id="navDropdown"
                             class="top-[calc(theme(spacing.nav)-6px)] shadow-dropdown z-[300] absolute right-0 hidden min-w-[180px] rounded-lg border border-gray-200 bg-white p-[0.35rem]">
                            <a class="block rounded-md px-3 py-2 text-[0.85rem] text-gray-600 no-underline transition hover:bg-gray-100 hover:text-black"
                               asp-controller="Profile" asp-action="Index">Profile</a>
                            <a class="block rounded-md px-3 py-2 text-[0.85rem] text-gray-600 no-underline transition hover:bg-gray-100 hover:text-black"
                               asp-controller="Profile" asp-action="Avatar">Avatar</a>
                            <div class="mt-1 border-t border-gray-100 pt-1">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 px-[0.35rem] py-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="flex w-full cursor-pointer items-center gap-2 rounded-md border-0 bg-transparent px-[0.4rem] py-2 text-left font-sans font-normal text-[0.85rem] text-[#dc2626] transition hover:bg-danger-bg">
                                        <svg class="h-[14px] w-[14px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                            <polyline points="16 17 21 12 16 7" />
                                            <line x1="21" y1="12" x2="9" y2="12" />
                                        </svg>
                                        Sign out
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login"
                       class="cursor-pointer rounded border border-gray-300 bg-transparent px-4 py-[0.4rem] font-medium text-[0.85rem] text-black no-underline transition hover:bg-gray-100 hover:text-black">Sign in</a>
                    <a asp-controller="Auth" asp-action="Register"
                       class="ml-2 cursor-pointer rounded border-0 bg-black px-4 py-[0.4rem] font-medium text-[0.85rem] text-white no-underline transition hover:text-white hover:opacity-85">Get started</a>
                }
            </div>

            <!-- Mobile hamburger -->
            <button id="hamburger" class="flex cursor-pointer flex-col gap-[5px] border-0 bg-none p-1 sm:hidden" aria-label="Open menu">
                <span class="h-[1.5px] block w-[22px] bg-black transition-all duration-200"></span>
                <span class="h-[1.5px] block w-[22px] bg-black transition-all duration-200"></span>
                <span class="h-[1.5px] block w-[22px] bg-black transition-all duration-200"></span>
            </button>
        </div>

        <!-- Mobile menu -->
        <div id="mobileMenu"
             class="absolute left-0 right-0 top-nav hidden flex-col gap-2 border-b border-gray-200 bg-white px-8 py-4">
            @if (User.Identity!.IsAuthenticated)
            {
                <a class="block w-full py-[0.6rem] text-left text-[0.85rem] text-gray-600 no-underline transition hover:text-black"
                   asp-controller="Blogs" asp-action="Index">Posts</a>
                <a class="block w-full py-[0.6rem] text-left text-[0.85rem] text-gray-600 no-underline transition hover:text-black"
                   asp-controller="Blogs" asp-action="Mine">My Blogs</a>
                @if (User.IsInRole("ADMIN"))
                {
                    <a class="block w-full py-[0.6rem] text-left text-[0.85rem] text-gray-600 no-underline transition hover:text-black"
                       asp-controller="Users" asp-action="Index">Users</a>
                }
                <a class="block w-full py-[0.6rem] text-left text-[0.85rem] text-gray-600 no-underline transition hover:text-black"
                   asp-controller="Profile" asp-action="Avatar">Profile</a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="block w-full cursor-pointer border-0 bg-none py-[0.6rem] text-left font-medium text-[0.85rem] text-black">Sign out</button>
                </form>
            }
            else
            {
                <a class="block w-full py-[0.6rem] text-left text-[0.85rem] text-gray-600 no-underline transition hover:text-black"
                   asp-controller="Auth" asp-action="Login">Sign in</a>
                <a class="block w-full py-[0.6rem] text-left text-[0.85rem] text-gray-600 no-underline transition hover:text-black"
                   asp-controller="Auth" asp-action="Register">Get started</a>
            }
        </div>
    </nav>

    <!-- ── Page content ── -->
    <main class="min-h-[calc(100vh-theme(spacing.nav)-56px)]">
        <div class="max-w-content mx-auto px-8 py-8">

            @if (TempData["Success"] != null)
            {
                <div class="mb-4 rounded-md border border-success-border bg-success-bg px-4 py-[0.65rem] text-[0.85rem] text-success-text">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mb-4 rounded-md border border-danger-border bg-danger-bg px-4 py-[0.65rem] text-[0.85rem] text-error">@TempData["Error"]</div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- ── Footer ── -->
    <footer class="flex items-center justify-center border-t border-gray-200 px-8 py-4">
        <p class="m-0 text-[0.775rem] text-gray-400">© @DateTime.Now.Year Tavian Blog App · ITC Group</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Hamburger toggle
        const hamburger = document.getElementById('hamburger');
        const mobileMenu = document.getElementById('mobileMenu');
        hamburger && hamburger.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
            mobileMenu.classList.toggle('flex');
        });

        // Avatar dropdown
        const avatarToggle = document.getElementById('avatarToggle');
        const navDropdown = document.getElementById('navDropdown');
        avatarToggle && avatarToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = navDropdown.classList.toggle('hidden');
            avatarToggle.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        });
        // close when clicking outside
        document.addEventListener('click', (e) => {
            if (!navDropdown) return;
            if (!navDropdown.contains(e.target) && !avatarToggle.contains(e.target)) {
                navDropdown.classList.add('hidden');
                avatarToggle && avatarToggle.setAttribute('aria-expanded', 'false');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
