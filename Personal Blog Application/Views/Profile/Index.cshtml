@model Personal_Blog_Application.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="mx-auto max-w-[640px]">
    <h1 class="font-display mb-8 tracking-tight text-[1.75rem] text-black">My profile</h1>

    <div class="rounded-md border border-gray-200 bg-white p-8">

        <!-- Avatar + identity row -->
        <div class="mb-8 flex items-center gap-6 border-b border-gray-200 pb-8">
            <button id="avatarChangeBtn" type="button"
                    class="group relative cursor-pointer rounded-full border-0 bg-transparent p-0"
                    aria-label="Change avatar">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="@Model.UserName"
                         class="h-24 w-24 rounded-full border-2 border-gray-200 object-cover" />
                }
                else
                {
                    <div class="flex h-24 w-24 items-center justify-center rounded-full border-2 border-gray-200 bg-gray-200 font-medium text-[1.5rem] text-gray-600">
                        @ViewHelpers.Initials(Model.UserName)
                    </div>
                }
                <span class="absolute inset-0 flex items-center justify-center rounded-full bg-black/55 opacity-0 transition group-hover:opacity-100">
                    <svg class="h-6 w-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z" />
                        <circle cx="12" cy="13" r="4" />
                    </svg>
                </span>
            </button>

            <div class="flex-1">
                <h2 class="font-display mb-1 tracking-tight text-[1.4rem] text-black">@Model.UserName</h2>
                <p class="mb-2 text-sm text-gray-600">@Model.Email</p>
                <div class="flex items-center gap-2">
                    @if (Model.Role == "ADMIN")
                    {
                        <span class="inline-flex items-center rounded-full bg-black px-2 py-1 font-medium text-[0.7rem] text-white">ADMIN</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-1 font-medium text-[0.7rem] text-gray-600">USER</span>
                    }
                    @if (Model.IsActive)
                    {
                        <span class="inline-flex items-center rounded-full bg-published-bg px-2 py-1 font-medium text-[0.7rem] text-published-text">Active</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-full bg-danger-bg px-2 py-1 font-medium text-[0.7rem] text-error">Inactive</span>
                    }
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="mb-8 grid grid-cols-2 gap-4 border-b border-gray-200 pb-8">
            <div>
                <p class="mb-1 font-medium uppercase tracking-wider text-[0.7rem] text-gray-400">Blogs</p>
                <p class="font-display text-[1.5rem] text-black">@Model.BlogCount</p>
            </div>
            <div>
                <p class="mb-1 font-medium uppercase tracking-wider text-[0.7rem] text-gray-400">Comments</p>
                <p class="font-display text-[1.5rem] text-black">@Model.CommentCount</p>
            </div>
        </div>

        <!-- Account actions -->
        <h3 class="font-display mb-4 text-[1.05rem] text-black">Account</h3>
        <div class="flex flex-col">
            <div class="flex items-center justify-between border-b border-gray-100 py-3">
                <div>
                    <p class="text-sm font-medium text-black">Username</p>
                    <p class="text-[0.775rem] text-gray-400">@Model.UserName</p>
                </div>
                <button type="button" disabled
                        class="h-[34px] inline-flex cursor-not-allowed items-center justify-center rounded border border-gray-200 bg-transparent px-4 font-medium text-[0.8rem] text-gray-400">
                    Coming soon
                </button>
            </div>
            <div class="flex items-center justify-between py-3">
                <div>
                    <p class="text-sm font-medium text-black">Password</p>
                    <p class="text-[0.775rem] text-gray-400">••••••••</p>
                </div>
                <button type="button" disabled
                        class="h-[34px] inline-flex cursor-not-allowed items-center justify-center rounded border border-gray-200 bg-transparent px-4 font-medium text-[0.8rem] text-gray-400">
                    Coming soon
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ── Avatar upload modal ─────────────────────────────────────────── -->
<div id="avatarModal" class="z-[1000] fixed inset-0 hidden items-center justify-center bg-black/45 p-4">
    <div class="w-full max-w-[440px] rounded-md bg-white p-8 shadow-[0_25px_60px_rgba(0,0,0,0.2)]">
        <h2 class="font-display mb-2 tracking-tight text-[1.25rem]">Change avatar</h2>
        <p class="mb-6 text-sm leading-relaxed text-gray-600">JPG, PNG, or GIF. Max 2 MB.</p>

        <form asp-controller="Profile" asp-action="Avatar" method="post" enctype="multipart/form-data" id="avatarForm">
            @Html.AntiForgeryToken()

            <div class="mb-6 flex items-center justify-center">
                <div id="avatarPreviewWrap"
                     class="flex h-32 w-32 items-center justify-center overflow-hidden rounded-full border-2 border-gray-200 bg-gray-50">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="" class="h-full w-full object-cover" />
                    }
                    else
                    {
                        <span class="text-[1.5rem] text-gray-400">@ViewHelpers.Initials(Model.UserName)</span>
                    }
                </div>
            </div>

            <label class="mb-6 block">
                <span class="mb-2 block text-sm font-medium text-black">Choose image</span>
                <input type="file" name="File" id="avatarFile"
                       accept=".jpg,.jpeg,.png,.gif,image/jpeg,image/png,image/gif"
                       class="block w-full cursor-pointer text-sm text-gray-600 file:mr-3 file:cursor-pointer file:rounded file:border-0 file:bg-gray-100 file:px-4 file:py-2 file:font-medium file:text-black hover:file:bg-gray-200" />
                <span id="avatarFileError" class="mt-2 block min-h-[1em] text-[0.775rem] text-error"></span>
            </label>

            <div class="flex justify-end gap-2">
                <button type="button" id="avatarCancel"
                        class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-gray-600 transition hover:-translate-y-px hover:border-gray-300 hover:bg-gray-100 hover:text-black active:translate-y-0">
                    Cancel
                </button>
                <button type="submit" id="avatarSubmit"
                        class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-white transition hover:-translate-y-px hover:shadow-btn-primary-hover hover:opacity-90 active:translate-y-0 disabled:pointer-events-none disabled:opacity-50">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const openBtn = document.getElementById('avatarChangeBtn');
            const modal = document.getElementById('avatarModal');
            const cancelBtn = document.getElementById('avatarCancel');
            const fileInput = document.getElementById('avatarFile');
            const previewWrap = document.getElementById('avatarPreviewWrap');
            const fileError = document.getElementById('avatarFileError');
            const submitBtn = document.getElementById('avatarSubmit');

            const MAX_BYTES = 2 * 1024 * 1024;
            const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/gif'];
            const initialPreview = previewWrap.innerHTML;

            function openModal() {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                fileError.textContent = '';
                submitBtn.disabled = false;
            }
            function closeModal() {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                fileInput.value = '';
                fileError.textContent = '';
                previewWrap.innerHTML = initialPreview;
                submitBtn.disabled = false;
            }

            openBtn.addEventListener('click', openModal);
            cancelBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
            });

            fileInput.addEventListener('change', function () {
                fileError.textContent = '';
                submitBtn.disabled = false;
                const file = this.files && this.files[0];
                if (!file) {
                    previewWrap.innerHTML = initialPreview;
                    return;
                }
                if (!ALLOWED_TYPES.includes(file.type)) {
                    fileError.textContent = 'Only JPG, PNG, or GIF images are allowed.';
                    submitBtn.disabled = true;
                    return;
                }
                if (file.size > MAX_BYTES) {
                    fileError.textContent = 'Image must be 2 MB or smaller.';
                    submitBtn.disabled = true;
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewWrap.innerHTML =
                        '<img alt="" class="h-full w-full object-cover" src="' + e.target.result + '" />';
                };
                reader.readAsDataURL(file);
            });
        })();
    </script>
}
