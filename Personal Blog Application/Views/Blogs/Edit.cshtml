@model Personal_Blog_Application.ViewModels.BlogCreateViewModel

@{
    ViewData["Title"] = "Edit Post";
    var blogId = (int)ViewBag.BlogId;
}

<div style="max-width:760px;margin:0 auto">

    <!-- Header -->
    <div style="margin-bottom:2rem">
        <a asp-action="Index" class="btn btn-link" style="margin-bottom:1rem">
            ← Back to posts
        </a>
        <h1 style="font-family:var(--font-display);font-size:2rem;
                   letter-spacing:-0.03em">Edit Post</h1>
    </div>

    <form asp-action="Edit" asp-route-id="@blogId" method="post">
        @Html.AntiForgeryToken()

        <!-- Title -->
        <div style="margin-bottom:1.5rem">
            <label asp-for="Title"
                   style="display:block;font-size:0.775rem;font-weight:500;
                          letter-spacing:0.08em;text-transform:uppercase;
                          color:var(--gray-600);margin-bottom:0.5rem">
                Title
            </label>
            <input asp-for="Title"
                   placeholder="Enter your post title..."
                   style="width:100%;height:48px;padding:0 1rem;
                          font-family:var(--font-body);font-size:0.9rem;
                          border:1px solid var(--gray-200);border-radius:2px;
                          outline:none;background:var(--gray-50);
                          transition:border-color 0.18s"
                   onfocus="this.style.borderColor='var(--black)';this.style.background='#fff'"
                   onblur="this.style.borderColor='var(--gray-200)';this.style.background='var(--gray-50)'" />
            <span asp-validation-for="Title"
                  style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
            </span>
        </div>

        <!-- Priority + Status row -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem">
            <div>
                <label asp-for="Priority"
                       style="display:block;font-size:0.775rem;font-weight:500;
                              letter-spacing:0.08em;text-transform:uppercase;
                              color:var(--gray-600);margin-bottom:0.5rem">
                    Priority
                </label>
                <select asp-for="Priority"
                        style="width:100%;height:48px;padding:0 1rem;
                               font-family:var(--font-body);font-size:0.875rem;
                               border:1px solid var(--gray-200);border-radius:2px;
                               background:var(--gray-50);outline:none;cursor:pointer">
                    <option value="1">P1 — Lowest</option>
                    <option value="2">P2 — Low</option>
                    <option value="3">P3 — Medium</option>
                    <option value="4">P4 — High</option>
                    <option value="5">P5 — Highest</option>
                </select>
                <span asp-validation-for="Priority"
                      style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
                </span>
            </div>

            <div>
                <label asp-for="Status"
                       style="display:block;font-size:0.775rem;font-weight:500;
                              letter-spacing:0.08em;text-transform:uppercase;
                              color:var(--gray-600);margin-bottom:0.5rem">
                    Visibility
                </label>
                <select asp-for="Status"
                        style="width:100%;height:48px;padding:0 1rem;
                               font-family:var(--font-body);font-size:0.875rem;
                               border:1px solid var(--gray-200);border-radius:2px;
                               background:var(--gray-50);outline:none;cursor:pointer">
                    <option value="DRAFT">Draft — only visible to you</option>
                    <option value="PUBLISHED">Published — visible to everyone</option>
                    <option value="PRIVATE">Private — only visible to you</option>
                </select>
                <span asp-validation-for="Status"
                      style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
                </span>
            </div>
        </div>

        <!-- Content -->
        <div style="margin-bottom:2rem">
            <label asp-for="Content"
                   style="display:block;font-size:0.775rem;font-weight:500;
                          letter-spacing:0.08em;text-transform:uppercase;
                          color:var(--gray-600);margin-bottom:0.5rem">
                Content
            </label>
            <input type="hidden" asp-for="Content" id="Content" />
            <div id="quill-editor" style="margin-bottom:0.5rem"></div>
            <span asp-validation-for="Content"
                  style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
            </span>
        </div>

        <!-- Actions -->
        <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap">
            <button type="submit" class="btn btn-primary btn-lg">Save changes</button>
            <a asp-action="Detail" asp-route-id="@blogId" class="btn btn-ghost btn-lg">Cancel</a>
            <button type="button" id="open-delete" class="btn btn-danger btn-lg" style="margin-left:auto">
                Delete post
            </button>
        </div>
    </form>
</div>

<!-- Delete confirmation modal -->
<div id="delete-modal"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);
            z-index:1000;align-items:center;justify-content:center;padding:1rem">
    <div style="background:#fff;border-radius:6px;max-width:440px;width:100%;
                padding:2rem;box-shadow:0 25px 60px rgba(0,0,0,0.2)">
        <h2 style="font-family:var(--font-display);font-size:1.35rem;
                   letter-spacing:-0.02em;margin-bottom:0.5rem">
            Delete this post?
        </h2>
        <p style="font-size:0.875rem;color:var(--gray-600);margin-bottom:1.5rem;line-height:1.6">
            This will permanently delete the post. This action cannot be undone.
        </p>
        <div style="display:flex;justify-content:flex-end;gap:0.5rem">
            <button type="button" id="cancel-delete" class="btn btn-ghost btn-sm">Cancel</button>
            <form asp-action="Delete" asp-route-id="@blogId" method="post" style="margin:0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-sm">Delete post</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

    <style>
        .ql-toolbar {
            border: 1px solid var(--gray-200) !important;
            border-radius: 2px 2px 0 0 !important;
            font-family: var(--font-body) !important;
        }

        .ql-container {
            border: 1px solid var(--gray-200) !important;
            border-top: none !important;
            border-radius: 0 0 2px 2px !important;
            font-family: var(--font-body) !important;
            font-size: 15px !important;
        }

        .ql-editor {
            min-height: 320px;
            line-height: 1.75;
        }

            .ql-editor.ql-blank::before {
                color: var(--gray-400) !important;
                font-style: normal !important;
            }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        (function () {
            const hiddenContent = document.getElementById('Content');
            const form = hiddenContent.closest('form');

            const quill = new Quill('#quill-editor', {
                theme: 'snow',
                placeholder: 'Write your post content here...',
                modules: {
                    toolbar: [
                        [{ header: [2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        ['link', 'image'],
                        ['clean']
                    ]
                }
            });

            // Pre-fill Quill with existing content
            if (hiddenContent.value) {
                quill.clipboard.dangerouslyPasteHTML(hiddenContent.value);
            }

            function syncContent() {
                const isEmpty = quill.getText().trim().length === 0;
                hiddenContent.value = isEmpty ? '' : quill.root.innerHTML;
            }

            quill.on('text-change', syncContent);
            form.addEventListener('submit', syncContent);

            // ── Delete modal ──
            const modal = document.getElementById('delete-modal');
            const openBtn = document.getElementById('open-delete');
            const cancelBtn = document.getElementById('cancel-delete');

            openBtn.addEventListener('click', () => modal.style.display = 'flex');
            cancelBtn.addEventListener('click', () => modal.style.display = 'none');
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.style.display = 'none';
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') modal.style.display = 'none';
            });
        })();
    </script>
}
