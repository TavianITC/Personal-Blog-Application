@model Personal_Blog_Application.ViewModels.BlogCreateViewModel

@{
    ViewData["Title"] = "Edit Post";
    var blogId = (int)ViewBag.BlogId;

    var from = Context.Request.Query["from"].ToString();
    var backAction = from == "mine" ? "Mine" : "Index";
    var backLabel = from == "mine" ? "Back to my posts" : "Back to posts";
}

<div class="mx-auto max-w-[760px]">

    <!-- Header -->
    <div class="mb-8">
        <a asp-action="@backAction"
           class="mb-4 inline-block text-[0.825rem] text-gray-600 transition hover:-translate-x-0.5 hover:text-black">
            ← @backLabel
        </a>
        <h1 class="font-display tracking-[-0.03em] text-[2rem]">Edit Post</h1>
    </div>

    <form asp-action="Edit" asp-route-id="@blogId" asp-route-from="@from" method="post">
        @Html.AntiForgeryToken()

        <!-- Title -->
        <div class="mb-6">
            <label asp-for="Title" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Title</label>
            <input asp-for="Title" placeholder="Enter your post title..."
                   class="h-12 w-full rounded border border-gray-200 bg-gray-50 px-4 font-sans text-[0.9rem] outline-none transition focus:border-black focus:bg-white" />
            <span asp-validation-for="Title" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
        </div>

        <!-- Priority + Status row -->
        <div class="mb-6 grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Priority" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Priority</label>
                <select asp-for="Priority"
                        class="h-12 w-full cursor-pointer rounded border border-gray-200 bg-gray-50 px-4 font-sans text-sm outline-none">
                    <option value="1">P1 — Lowest</option>
                    <option value="2">P2 — Low</option>
                    <option value="3">P3 — Medium</option>
                    <option value="4">P4 — High</option>
                    <option value="5">P5 — Highest</option>
                </select>
                <span asp-validation-for="Priority" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
            </div>

            <div>
                <label asp-for="Status" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Visibility</label>
                <select asp-for="Status"
                        class="h-12 w-full cursor-pointer rounded border border-gray-200 bg-gray-50 px-4 font-sans text-sm outline-none">
                    <option value="DRAFT">Draft — only visible to you</option>
                    <option value="PUBLISHED">Published — visible to everyone</option>
                    <option value="PRIVATE">Private — only visible to you</option>
                </select>
                <span asp-validation-for="Status" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
            </div>
        </div>

        <!-- Content -->
        <div class="mb-8">
            <label asp-for="Content" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Content</label>
            <input type="hidden" asp-for="Content" id="Content" />
            <div id="quill-editor" class="mb-2"></div>
            <span asp-validation-for="Content" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap items-center gap-3">
            <button type="submit"
                    class="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-6 font-sans text-sm font-medium leading-none text-white transition hover:shadow-btn-primary-hover hover:-translate-y-px hover:opacity-90 active:translate-y-0">
                Save changes
            </button>
            <a asp-action="Detail" asp-route-id="@blogId" asp-route-from="@from"
               class="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-6 font-sans text-sm font-medium leading-none text-gray-600 no-underline transition hover:-translate-y-px hover:border-gray-300 hover:bg-gray-100 hover:text-black active:translate-y-0">
                Cancel
            </a>
            <button type="button" id="open-delete"
                    class="ml-auto inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-error px-6 font-sans text-sm font-medium leading-none text-white transition hover:shadow-btn-danger-hover hover:-translate-y-px hover:opacity-90 active:translate-y-0">
                Delete post
            </button>
        </div>
    </form>
</div>

<!-- Delete confirmation modal -->
<div id="delete-modal"
     class="z-[1000] fixed inset-0 hidden items-center justify-center bg-black/45 p-4">
    <div class="w-full max-w-[440px] rounded-md bg-white p-8 shadow-[0_25px_60px_rgba(0,0,0,0.2)]">
        <h2 class="font-display mb-2 tracking-tight text-[1.35rem]">Delete this post?</h2>
        <p class="mb-6 text-sm leading-relaxed text-gray-600">
            This will permanently delete the post. This action cannot be undone.
        </p>
        <div class="flex justify-end gap-2">
            <button type="button" id="cancel-delete"
                    class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-gray-600 transition hover:border-gray-300 hover:bg-gray-100 hover:text-black">Cancel</button>
            <form asp-action="Delete" asp-route-id="@blogId" asp-route-from="@from" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-error px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-white transition hover:opacity-90">Delete post</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

    <style>
        .ql-toolbar {
            border: 1px solid #e8e8e8 !important;
            border-radius: 2px 2px 0 0 !important;
            font-family: 'DM Sans', system-ui, sans-serif !important;
        }
        .ql-container {
            border: 1px solid #e8e8e8 !important;
            border-top: none !important;
            border-radius: 0 0 2px 2px !important;
            font-family: 'DM Sans', system-ui, sans-serif !important;
            font-size: 15px !important;
        }
        .ql-editor {
            min-height: 320px;
            line-height: 1.75;
        }
        .ql-editor.ql-blank::before {
            color: #a0a0a0 !important;
            font-style: normal !important;
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        (function () {
            const hiddenContent = document.getElementById('Content');
            const form = hiddenContent.closest('form');

            const quill = new Quill('#quill-editor', {
                theme: 'snow',
                placeholder: 'Write your post content here...',
                modules: {
                    toolbar: [
                        [{ header: [2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        ['link', 'image'],
                        ['clean']
                    ]
                }
            });

            if (hiddenContent.value) {
                quill.clipboard.dangerouslyPasteHTML(hiddenContent.value);
            }

            function syncContent() {
                const isEmpty = quill.getText().trim().length === 0;
                hiddenContent.value = isEmpty ? '' : quill.root.innerHTML;
            }

            quill.on('text-change', syncContent);
            form.addEventListener('submit', syncContent);

            // ── Delete modal ──
            const modal = document.getElementById('delete-modal');
            const openBtn = document.getElementById('open-delete');
            const cancelBtn = document.getElementById('cancel-delete');

            function openModal() {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
            function closeModal() {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }

            openBtn.addEventListener('click', openModal);
            cancelBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
            });
        })();
    </script>
}
