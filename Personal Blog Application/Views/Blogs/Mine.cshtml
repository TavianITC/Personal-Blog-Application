@model List<Personal_Blog_Application.Models.Blog>

@{
    ViewData["Title"] = "My Blogs";
    var isAdmin = User.IsInRole("ADMIN");

    var groups = new (string Key, string Label, List<Personal_Blog_Application.Models.Blog> Items)[]
    {
        ("PUBLISHED", "Published", Model.Where(b => b.Status == "PUBLISHED").ToList()),
        ("PRIVATE",   "Private",   Model.Where(b => b.Status == "PRIVATE").ToList()),
        ("DRAFT",     "Drafts",    Model.Where(b => b.Status == "DRAFT").ToList())
    };

    string PriorityBadgeColors(int p) => p switch
    {
        5 => "bg-black text-white",
        4 => "bg-gray-800 text-white",
        3 => "bg-gray-200 text-black",
        2 => "bg-gray-100 text-gray-600",
        _ => "bg-gray-50 text-gray-400"
    };
}

<style>
    /* Hover-reveal action buttons + expandable label — non-trivial to express
       purely with utilities (active-tab underline pseudo, group-hover expand
       on a child width). Keep these tiny classes here. */
    .tab-btn.active { color: #0a0a0a; font-weight: 500; }
    .tab-btn.active::after {
        content: '';
        position: absolute;
        left: 0; right: 0; bottom: -1px;
        height: 2px;
        background: #0a0a0a;
    }
    .tab-btn.active .tab-count { background: #0a0a0a; color: #fff; }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .blog-actions { opacity: 0; transition: opacity 0.18s ease; }
    .blog-card-mine:hover .blog-actions,
    .blog-card-mine:focus-within .blog-actions { opacity: 1; }

    .blog-action .label { max-width: 0; opacity: 0; white-space: nowrap; transition: max-width 0.18s ease, opacity 0.18s ease; }
    .blog-action:hover { gap: 0.4rem !important; }
    .blog-action:hover .label { max-width: 80px; opacity: 1; }
</style>

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="font-display tracking-[-0.03em] mb-1 text-[2rem]">My Posts</h1>
        <p class="m-0 text-sm text-gray-600">
            @Model.Count post@(Model.Count != 1 ? "s" : "") total
        </p>
    </div>
    <a asp-action="Create"
       class="h-[42px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-5 font-sans text-sm font-medium leading-none text-white no-underline transition hover:shadow-btn-primary-hover hover:-translate-y-px hover:opacity-90 active:translate-y-0">+ New post</a>
</div>

@{
    var filterTitle = ViewBag.FilterTitle as string;
    var filterSort = ViewBag.FilterSort as string;
    var hasFilters = !string.IsNullOrWhiteSpace(filterTitle)
                  || !string.IsNullOrWhiteSpace(filterSort);
}

<!-- Filter bar -->
<form method="get" id="filter-form" class="mb-6 flex flex-wrap items-center gap-2">
    <input type="text" name="title" value="@filterTitle" placeholder="Search title…"
           class="h-[38px] flex-[1_1_200px] min-w-[200px] rounded border border-gray-200 bg-gray-50 px-[0.9rem] font-sans text-[0.85rem] text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
        <select name="sort"
            class="h-[38px] min-w-[200px] cursor-pointer rounded border border-gray-200 bg-gray-50 px-[0.9rem] font-sans text-[0.85rem] text-black outline-none transition focus:border-black focus:bg-white">
        <option value="" selected="@(string.IsNullOrEmpty(filterSort))">Sort: Newest</option>
        <option value="priority_desc" selected="@(filterSort == "priority_desc" || filterSort == "priority")">Sort: Priority — High to low</option>
        <option value="priority_asc" selected="@(filterSort == "priority_asc")">Sort: Priority — Low to high</option>
    </select>
    <button type="submit"
            class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-black transition hover:-translate-y-px hover:border-gray-400 hover:bg-gray-50 active:translate-y-0">Apply</button>
    @if (hasFilters)
    {
        <a asp-action="Mine"
           class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-gray-600 no-underline transition hover:border-gray-300 hover:bg-gray-100 hover:text-black">Clear</a>
    }
</form>

@if (!Model.Any())
{
    if (hasFilters)
    {
        <div class="py-16 text-center text-gray-400">
            <p class="font-display mb-2 text-xl tracking-tight text-gray-600">No posts match</p>
            <p class="mb-6 text-sm">Try a different keyword or clear your filters.</p>
            <a asp-action="Mine"
               class="h-[42px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-5 font-sans text-sm font-medium leading-none text-black no-underline transition hover:border-gray-400 hover:bg-gray-50">Clear filters</a>
        </div>
    }
    else
    {
        <div class="py-16 text-center text-gray-400">
            <p class="font-display mb-2 text-xl tracking-tight text-gray-600">No posts yet</p>
            <p class="mb-6 text-sm">Start writing your first blog post.</p>
            <a asp-action="Create"
               class="h-[42px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-5 font-sans text-sm font-medium leading-none text-white no-underline transition hover:opacity-90">Create post</a>
        </div>
    }
}
else
{
    <!-- Tabs -->
    <div class="mb-8 flex border-b border-gray-200" role="tablist">
        @for (var i = 0; i < groups.Length; i++)
        {
            var g = groups[i];
            <button type="button"
                    class="tab-btn @(i == 0 ? "active" : "") relative inline-flex cursor-pointer items-center gap-2 border-0 bg-transparent px-5 py-[0.85rem] font-sans text-sm text-gray-600 transition hover:text-black"
                    data-tab="@g.Key" role="tab">
                @g.Label
                <span class="tab-count inline-flex h-5 min-w-[22px] items-center justify-center rounded-full bg-gray-100 px-[0.45rem] font-medium text-[0.7rem] text-gray-600">@g.Items.Count</span>
            </button>
        }
    </div>

    <!-- Panels -->
    @for (var i = 0; i < groups.Length; i++)
    {
        var g = groups[i];
        <div class="tab-panel @(i == 0 ? "active" : "")" data-panel="@g.Key">
            @if (!g.Items.Any())
            {
                <div class="py-16 text-center text-gray-400">
                    <p class="font-display mb-2 text-xl tracking-tight text-gray-600">No @g.Label.ToLower() posts</p>
                    <p class="text-sm">
                        @switch (g.Key)
                        {
                            case "DRAFT":
                                <text>Drafts you save will show up here so you can keep writing.</text>
                                break;
                            case "PRIVATE":
                                <text>Posts marked as private will appear here. Only you can see them.</text>
                                break;
                            default:
                                <text>Publish a post to share it with everyone.</text>
                                break;
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    @foreach (var blog in g.Items)
                    {
                        var authorName = blog.User?.UserName ?? "Unknown";
                        <article class="blog-card-mine relative flex flex-col rounded-md border border-gray-200 bg-white p-7 transition hover:-translate-y-0.5 hover:border-gray-400">
                            <div class="mb-4 flex items-center gap-[0.6rem]">
                                <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-gray-200 font-semibold text-[0.7rem] text-gray-600">@ViewHelpers.Initials(authorName)</div>
                                <span class="flex-1 overflow-hidden text-ellipsis whitespace-nowrap text-[0.775rem] text-gray-600">
                                    <strong class="font-medium text-black">@authorName</strong>
                                    <span class="mx-[0.35rem] text-gray-400">·</span>
                                    @ViewHelpers.RelativeTime(blog.CreatedAt)
                                </span>
                                @if (blog.Status == "DRAFT")
                                {
                                    <span class="inline-flex flex-shrink-0 items-center gap-[0.3rem] rounded-full bg-draft-bg px-[0.55rem] py-[0.2rem] font-medium text-[0.7rem] text-draft-text">Draft</span>
                                }
                                else if (blog.Status == "PRIVATE")
                                {
                                    <span class="inline-flex flex-shrink-0 items-center gap-[0.3rem] rounded-full bg-private-bg px-[0.55rem] py-[0.2rem] font-medium text-[0.7rem] text-private-text">Private</span>
                                }
                                else if (blog.Status == "PUBLISHED")
                                {
                                    <span class="inline-flex flex-shrink-0 items-center gap-[0.3rem] rounded-full bg-published-bg px-[0.55rem] py-[0.2rem] font-medium text-[0.7rem] text-published-text">Published</span>
                                }
                                @if (blog.Comments.Count > 0)
                                {
                                    <span class="inline-flex flex-shrink-0 items-center gap-1 rounded-full bg-gray-100 px-2 py-1 font-medium text-[0.7rem] text-gray-600" title="@blog.Comments.Count comment@(blog.Comments.Count != 1 ? "s" : "")">
                                        <svg class="h-3 w-3 fill-none stroke-current" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
                                        </svg>
                                        @blog.Comments.Count
                                    </span>
                                }
                                <span class="inline-flex flex-shrink-0 items-center rounded-full px-[0.6rem] py-1 font-medium text-[0.7rem] @PriorityBadgeColors(blog.Priority)">P@(blog.Priority)</span>
                            </div>

                            <a asp-action="Detail" asp-route-id="@blog.Id" asp-route-from="mine"
                               class="font-display mb-[0.6rem] block leading-tight tracking-tight text-[1.25rem] text-black no-underline hover:text-black hover:no-underline"
                               title="@blog.Title">
                                @blog.Title
                            </a>

                            <p class="leading-[1.65] mb-0 flex-1 overflow-hidden text-sm text-gray-600 [display:-webkit-box] [-webkit-line-clamp:3] [-webkit-box-orient:vertical]">@ViewHelpers.Excerpt(blog.Content)</p>

                            <div class="blog-actions absolute bottom-3 right-3 flex items-center gap-1">
                                @if (blog.Status == "DRAFT")
                                {
                                    <a asp-action="Edit" asp-route-id="@blog.Id"
                                       class="blog-action h-[30px] inline-flex items-center rounded bg-white px-[0.4rem] text-[0.75rem] text-black no-underline transition hover:bg-gray-100"
                                       aria-label="Continue writing" title="Continue writing">
                                        <svg class="h-[14px] w-[14px] flex-shrink-0 fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
                                        </svg>
                                        <span class="label">Continue</span>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Detail" asp-route-id="@blog.Id" asp-route-from="mine"
                                       class="blog-action h-[30px] inline-flex items-center rounded bg-white px-[0.4rem] text-[0.75rem] text-black no-underline transition hover:bg-gray-100"
                                       aria-label="View" title="View">
                                        <svg class="h-[14px] w-[14px] flex-shrink-0 fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                        <span class="label">View</span>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@blog.Id"
                                       class="blog-action h-[30px] inline-flex items-center rounded bg-white px-[0.4rem] text-[0.75rem] text-gray-600 no-underline transition hover:bg-gray-100 hover:text-black"
                                       aria-label="Edit" title="Edit">
                                        <svg class="h-[14px] w-[14px] flex-shrink-0 fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
                                        </svg>
                                        <span class="label">Edit</span>
                                    </a>
                                }
                                <button type="button"
                                        class="blog-action js-delete h-[30px] font-[inherit] inline-flex cursor-pointer items-center rounded border-0 bg-white px-[0.4rem] text-[0.75rem] text-gray-600 transition hover:bg-danger-bg hover:text-error"
                                        data-id="@blog.Id"
                                        data-title="@blog.Title"
                                        aria-label="Delete" title="Delete">
                                    <svg class="h-[14px] w-[14px] flex-shrink-0 fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6l-2 14a2 2 0 01-2 2H9a2 2 0 01-2-2L5 6" />
                                        <path d="M10 11v6M14 11v6" />
                                        <path d="M9 6V4a2 2 0 012-2h2a2 2 0 012 2v2" />
                                    </svg>
                                    <span class="label">Delete</span>
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    }

    <!-- Delete confirmation modal (shared) -->
    <div id="delete-modal"
         class="z-[1000] fixed inset-0 hidden items-center justify-center bg-black/45 p-4">
        <div class="w-full max-w-[440px] rounded-md bg-white p-8 shadow-[0_25px_60px_rgba(0,0,0,0.2)]">
            <h2 class="font-display mb-2 tracking-tight text-[1.35rem]">Delete this post?</h2>
            <p class="mb-6 text-sm leading-relaxed text-gray-600">
                "<strong id="delete-title"></strong>" will be permanently deleted. This action cannot be undone.
            </p>
            <div class="flex justify-end gap-2">
                <button type="button" id="delete-cancel"
                        class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-gray-600 transition hover:border-gray-300 hover:bg-gray-100 hover:text-black">Cancel</button>
                <form id="delete-form" method="post" action="" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-error px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-white transition hover:opacity-90">Delete post</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        (function () {
            // ── Tabs ──────────────────────────────────────────────
            const tabs = document.querySelectorAll('.tab-btn');
            const panels = document.querySelectorAll('.tab-panel');

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    const key = tab.getAttribute('data-tab');
                    tabs.forEach(t => t.classList.toggle('active', t === tab));
                    panels.forEach(p => p.classList.toggle('active', p.getAttribute('data-panel') === key));
                    history.replaceState(null, '', location.pathname + location.search + '#' + key.toLowerCase());
                });
            });

            const hash = (location.hash || '').replace('#', '').toUpperCase();
            if (hash) {
                const target = document.querySelector('.tab-btn[data-tab="' + hash + '"]');
                if (target) target.click();
            }

            // ── Filter form: preserve current tab hash on submit ──
            const filterForm = document.getElementById('filter-form');
            if (filterForm) {
                filterForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const params = new URLSearchParams();
                    new FormData(filterForm).forEach((value, key) => {
                        if (value) params.append(key, value);
                    });
                    const query = params.toString();
                    window.location.href = location.pathname + (query ? '?' + query : '') + location.hash;
                });
            }

            // ── Delete modal ──────────────────────────────────────
            const modal = document.getElementById('delete-modal');
            const titleEl = document.getElementById('delete-title');
            const form = document.getElementById('delete-form');
            const cancelBtn = document.getElementById('delete-cancel');

            function openModal() { modal.classList.remove('hidden'); modal.classList.add('flex'); }
            function closeModal() { modal.classList.add('hidden'); modal.classList.remove('flex'); }

            document.querySelectorAll('.js-delete').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const id = btn.getAttribute('data-id');
                    const title = btn.getAttribute('data-title');
                    titleEl.textContent = title;
                    form.action = '@Url.Action("Delete", "Blogs")/' + id;
                    openModal();
                });
            });

            cancelBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
            });
        })();
    </script>
}
