@model List<Personal_Blog_Application.Models.Blog>

@{
    ViewData["Title"] = "My Blogs";
    var isAdmin = User.IsInRole("ADMIN");
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem">
    <div>
        <h1 style="font-family:var(--font-display);font-size:2rem;
            letter-spacing:-0.03em;margin-bottom:0.25rem">
            @(isAdmin ? "All Posts" : "My Posts")
        </h1>
        <p style="font-size:0.875rem;color:var(--gray-600)">
            @Model.Count post@(Model.Count != 1 ? "s" : "")
        </p>
    </div>
    <a asp-action="Create"
       style="display:inline-flex;align-items:center;gap:0.5rem;
        height:42px;padding:0 1.25rem;background:var(--black);
        color:#fff;font-size:0.85rem;font-weight:500;
        border-radius:2px;text-decoration:none">
        + New post
    </a>
</div>

@if (!Model.Any())
{
    <div style="text-align:center;padding:5rem 0;color:var(--gray-400)">
        <p style="font-family:var(--font-display);font-size:1.5rem;
            letter-spacing:-0.02em;margin-bottom:0.5rem">
            No posts yet
        </p>
        <p style="font-size:0.875rem;margin-bottom:1.5rem">
            Start writing your first blog post.
        </p>
        <a asp-action="Create"
           style="background:var(--black);color:#fff;padding:0.6rem 1.5rem;
            border-radius:2px;text-decoration:none;font-size:0.875rem">
            Create post
        </a>
    </div>
}
else
{
    <div style="border:1px solid var(--gray-200);border-radius:4px;
        overflow:hidden;background:#fff">
        <table style="width:100%;border-collapse:collapse">
            <thead>
                <tr style="border-bottom:1px solid var(--gray-200);
                    background:var(--gray-50)">
                    <th style="padding:0.75rem 1.25rem;text-align:left;
                    font-size:0.725rem;font-weight:500;
                    letter-spacing:0.08em;text-transform:uppercase;
                    color:var(--gray-600)">Title</th>
                    @if (isAdmin)
                    {
                        <th style="padding:0.75rem 1rem;text-align:left;
                        font-size:0.725rem;font-weight:500;
                        letter-spacing:0.08em;text-transform:uppercase;
                        color:var(--gray-600)">Author</th>
                    }
                    <th style="padding:0.75rem 1rem;text-align:center;
                    font-size:0.725rem;font-weight:500;
                    letter-spacing:0.08em;text-transform:uppercase;
                    color:var(--gray-600)">Priority</th>
                    <th style="padding:0.75rem 1rem;text-align:left;
                    font-size:0.725rem;font-weight:500;
                    letter-spacing:0.08em;text-transform:uppercase;
                    color:var(--gray-600)">Date</th>
                    <th style="padding:0.75rem 1rem;text-align:right;
                    font-size:0.725rem;font-weight:500;
                    letter-spacing:0.08em;text-transform:uppercase;
                    color:var(--gray-600)">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var blog in Model)
                {
                    <tr style="border-bottom:1px solid var(--gray-200);
                        transition:background 0.15s"
                        onmouseover="this.style.background='var(--gray-50)'"
                        onmouseout="this.style.background=''">
                        <td style="padding:1rem 1.25rem;max-width:320px">
                            <a asp-action="Detail" asp-route-id="@blog.Id"
                               style="font-weight:500;color:var(--black);
                                text-decoration:none;font-size:0.9rem;
                                display:block;white-space:nowrap;
                                overflow:hidden;text-overflow:ellipsis"
                               title="@blog.Title">
                                @blog.Title
                            </a>
                        </td>
                        @if (isAdmin)
                        {
                            <td style="padding:1rem;font-size:0.85rem;
                                color:var(--gray-600)">
                                @blog.User?.UserName
                            </td>
                        }
                        <td style="padding:1rem;text-align:center">
                            @{
                                var (bg, fg) = blog.Priority switch
                                {
                                    5 => ("#0a0a0a", "#ffffff"),
                                    4 => ("#262626", "#ffffff"),
                                    3 => ("#e8e8e8", "#0a0a0a"),
                                    2 => ("#f4f4f4", "#525252"),
                                    _ => ("#fafafa", "#a0a0a0")
                                };
                            }
                            <span style="display:inline-block;padding:0.2rem 0.6rem;
                                border-radius:100px;font-size:0.72rem;
                                font-weight:500;background:@bg;color:@fg">
                                P@(blog.Priority)
                            </span>
                        </td>
                        <td style="padding:1rem;font-size:0.825rem;
                            color:var(--gray-600);white-space:nowrap">
                            @blog.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </td>
                        <td style="padding:1rem;text-align:right;white-space:nowrap">
                            <a asp-action="Detail" asp-route-id="@blog.Id"
                               style="font-size:0.8rem;color:var(--gray-600);
                            text-decoration:none;padding:0.3rem 0.6rem;
                            border-radius:2px;transition:background 0.15s"
                               onmouseover="this.style.background='var(--gray-100)'"
                               onmouseout="this.style.background=''">View</a>
                            <a asp-action="Edit" asp-route-id="@blog.Id"
                               style="font-size:0.8rem;color:var(--gray-600);
                            text-decoration:none;padding:0.3rem 0.6rem;
                            border-radius:2px;margin-left:0.25rem;
                            transition:background 0.15s"
                               onmouseover="this.style.background='var(--gray-100)'"
                               onmouseout="this.style.background=''">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}