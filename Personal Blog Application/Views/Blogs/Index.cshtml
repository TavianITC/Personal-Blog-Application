@model List<Personal_Blog_Application.Models.Blog>

@{
    ViewData["Title"] = "Posts";

    var isAdmin = User.IsInRole("ADMIN");
    var filterTitle = ViewBag.FilterTitle as string;
    var filterAuthor = ViewBag.FilterAuthor as string;
    var filterSort = ViewBag.FilterSort as string;
    var hasFilters = !string.IsNullOrWhiteSpace(filterTitle)
                  || !string.IsNullOrWhiteSpace(filterAuthor)
                  || !string.IsNullOrWhiteSpace(filterSort);
}

<!-- Header section -->
<div class="mb-6">
    <span class="tracking-[0.1em] mb-[0.85rem] inline-flex items-center gap-[0.4rem] rounded-full bg-gray-100 px-[0.65rem] py-[0.3rem] font-medium uppercase text-[0.7rem] text-gray-600
                 before:content-[''] before:h-[5px] before:w-[5px] before:rounded-full before:bg-black">
        @(isAdmin ? "Admin" : "Community")
    </span>
    <h1 class="font-display tracking-[-0.03em] mb-[0.4rem] text-[clamp(2rem,4vw,2.75rem)]">Posts</h1>
    <p class="m-0 mb-4 max-w-[540px] leading-relaxed text-[0.925rem] text-gray-600">
        @if (isAdmin)
        {
            <text>
                You're viewing every post in the system — including drafts and
                private posts from other authors. Filter or sort to narrow it down.
            </text>
        }
        else
        {
            <text>
                Latest writing from across the community. Discover what other
                authors are publishing — search by title or filter by name.
            </text>
        }
    </p>
</div>

<div class="mb-5 flex flex-wrap items-center justify-between gap-4">
    <span class="text-[0.85rem] text-gray-600">
        @Model.Count post@(Model.Count != 1 ? "s" : "") @(hasFilters ? "found" : isAdmin ? "total" : "published")
        @if (isAdmin)
        {
            <span class="ml-2 inline-flex items-center gap-[0.4rem] rounded-full bg-gray-100 px-3 py-[0.35rem] text-[0.72rem] text-gray-600
                          before:content-[''] before:h-[5px] before:w-[5px] before:rounded-full before:bg-[#b54708]">
                Admin view — all statuses
            </span>
        }
    </span>
    <div class="flex gap-2">
        <a asp-action="Mine"
           class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-black no-underline transition hover:-translate-y-px hover:border-gray-400 hover:bg-gray-50 active:translate-y-0">My blogs</a>
        <a asp-action="Create"
           class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-white no-underline transition hover:shadow-btn-primary-hover hover:-translate-y-px hover:opacity-90 active:translate-y-0">+ New post</a>
    </div>
</div>

<!-- Filter bar -->
<form method="get" id="filter-form" class="mb-6 flex flex-wrap items-center gap-2">
    <input type="text" name="title" value="@filterTitle" placeholder="Search title…"
           class="h-[38px] flex-[1_1_200px] min-w-[200px] rounded border border-gray-200 bg-gray-50 px-[0.9rem] font-sans text-[0.85rem] text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
    <input type="text" name="author" value="@filterAuthor" placeholder="Author…"
           class="h-[38px] flex-[1_1_200px] min-w-[200px] rounded border border-gray-200 bg-gray-50 px-[0.9rem] font-sans text-[0.85rem] text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
    <select name="sort"
            class="h-[38px] min-w-[200px] cursor-pointer rounded border border-gray-200 bg-gray-50 px-[0.9rem] font-sans text-[0.85rem] text-black outline-none transition focus:border-black focus:bg-white">
        <option value="" selected="@(string.IsNullOrEmpty(filterSort))">Sort: Newest</option>
        <option value="priority_desc" selected="@(filterSort == "priority_desc" || filterSort == "priority")">Sort: Priority — High to low</option>
        <option value="priority_asc" selected="@(filterSort == "priority_asc")">Sort: Priority — Low to high</option>
    </select>
    <button type="submit"
            class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-black transition hover:-translate-y-px hover:border-gray-400 hover:bg-gray-50 active:translate-y-0">Apply</button>
    @if (hasFilters)
    {
        <a asp-action="Index"
           class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-gray-600 no-underline transition hover:border-gray-300 hover:bg-gray-100 hover:text-black">Clear</a>
    }
</form>

@if (!Model.Any())
{
    if (hasFilters)
    {
        <div class="py-16 text-center text-gray-400">
            <p class="font-display mb-2 text-2xl tracking-tight text-gray-600">No posts match</p>
            <p class="mb-6 text-sm">Try a different keyword or clear your filters.</p>
            <a asp-action="Index"
               class="h-[42px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-5 font-sans text-sm font-medium leading-none text-black no-underline transition hover:border-gray-400 hover:bg-gray-50">Clear filters</a>
        </div>
    }
    else
    {
        <div class="py-16 text-center text-gray-400">
            <p class="font-display mb-2 text-2xl tracking-tight text-gray-600">Quiet around here</p>
            <p class="mb-6 text-sm">Nobody has published anything yet. Be the first.</p>
            <a asp-action="Create"
               class="h-[42px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-5 font-sans text-sm font-medium leading-none text-white no-underline transition hover:opacity-90">Write the first post</a>
        </div>
    }
}
else
{
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        @foreach (var blog in Model)
        {
            <partial name="_BlogCard"
                     model="blog"
                     view-data='new ViewDataDictionary(ViewData) {
                         { "ShowStatusPill", isAdmin },
                         { "Compact", false },
                         { "From", "index" }
                     }' />
        }
    </div>

    <script>
        (function () {
            const form = document.getElementById('filter-form');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const params = new URLSearchParams();
                new FormData(form).forEach((value, key) => {
                    if (value) params.append(key, value);
                });
                const query = params.toString();
                window.location.href = location.pathname + (query ? '?' + query : '');
            });
        })();
    </script>
}
