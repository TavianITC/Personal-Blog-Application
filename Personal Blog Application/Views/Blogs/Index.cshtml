@using System.Text.RegularExpressions
@model List<Personal_Blog_Application.Models.Blog>

@{
    ViewData["Title"] = "Posts";

    var isAdmin = User.IsInRole("ADMIN");
    var filterTitle = ViewBag.FilterTitle as string;
    var filterAuthor = ViewBag.FilterAuthor as string;
    var filterSort = ViewBag.FilterSort as string;
    var hasFilters = !string.IsNullOrWhiteSpace(filterTitle)
                  || !string.IsNullOrWhiteSpace(filterAuthor)
                  || !string.IsNullOrWhiteSpace(filterSort);

    string Excerpt(string html, int max = 180)
    {
        if (string.IsNullOrWhiteSpace(html)) return string.Empty;
        var text = Regex.Replace(html, "<.*?>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        text = Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length <= max ? text : text.Substring(0, max).TrimEnd() + "…";
    }

    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(new[] { ' ', '.', '@', '_', '-' },
            StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    string RelativeTime(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM dd, yyyy");
    }
}

<style>
    /* ── Header (Posts) ── */
    .posts-header {
        margin-bottom: 1.5rem;
    }

    .posts-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-600);
        background: var(--gray-100);
        padding: 0.3rem 0.65rem;
        border-radius: 100px;
        margin-bottom: 0.85rem;
    }

        .posts-eyebrow::before {
            content: '';
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--black);
        }

    .posts-header h1 {
        font-family: var(--font-display);
        font-size: clamp(2rem, 4vw, 2.75rem);
        letter-spacing: -0.03em;
        margin-bottom: 0.4rem;
    }

    .posts-header p {
        font-size: 0.925rem;
        color: var(--gray-600);
        margin: 0 0 1rem;
        max-width: 540px;
        line-height: 1.6;
    }

    .posts-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }

    .posts-count {
        font-size: 0.85rem;
        color: var(--gray-600);
    }

    .toolbar-actions {
        display: flex;
        gap: 0.5rem;
    }

    /* ── Filter bar ── */
    .filter-bar {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .filter-input,
    .filter-select {
        height: 38px;
        padding: 0 0.9rem;
        font-family: var(--font-body);
        font-size: 0.85rem;
        color: var(--black);
        border: 1px solid var(--gray-200);
        border-radius: var(--radius);
        background: var(--gray-50);
        outline: none;
        transition: border-color var(--transition), background var(--transition);
    }

        .filter-input::placeholder {
            color: var(--gray-400);
        }

        .filter-input:focus,
        .filter-select:focus {
            border-color: var(--black);
            background: var(--white);
        }

    .filter-input {
        min-width: 200px;
        flex: 1 1 200px;
    }

    .filter-select {
        cursor: pointer;
        min-width: 200px;
    }

    /* ── Card grid ── */
    .posts-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
    }

    .post-card {
        position: relative;
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        transition: border-color var(--transition), transform var(--transition);
    }

        .post-card:hover {
            border-color: var(--gray-400);
            transform: translateY(-2px);
            color: inherit;
            text-decoration: none;
        }

    .post-card-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1rem;
    }

    .post-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--gray-200);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-600);
        flex-shrink: 0;
    }

    .post-meta {
        font-size: 0.775rem;
        color: var(--gray-600);
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .post-meta strong {
            font-weight: 500;
            color: var(--black);
        }

        .post-meta .dot {
            color: var(--gray-400);
            margin: 0 0.35rem;
        }

    .post-badge {
        font-size: 0.7rem;
        font-weight: 500;
        padding: 0.25rem 0.6rem;
        border-radius: 100px;
        background: var(--gray-100);
        color: var(--gray-600);
        flex-shrink: 0;
    }

        .post-badge.p5 {
            background: #0a0a0a;
            color: #fff;
        }

        .post-badge.p4 {
            background: #262626;
            color: #fff;
        }

        .post-badge.p3 {
            background: #e8e8e8;
            color: #0a0a0a;
        }

        .post-badge.p2 {
            background: #f4f4f4;
            color: #525252;
        }

        .post-badge.p1 {
            background: #fafafa;
            color: #a0a0a0;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        font-size: 0.65rem;
        font-weight: 500;
        padding: 0.18rem 0.5rem;
        border-radius: 100px;
        background: var(--gray-100);
        color: var(--gray-600);
        flex-shrink: 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

        .status-pill.draft {
            background: #fff7e6;
            color: #b54708;
        }

        .status-pill.private {
            background: #f0f1ff;
            color: #3b3f87;
        }

    .admin-note {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.72rem;
        color: var(--gray-600);
        background: var(--gray-100);
        padding: 0.35rem 0.75rem;
        border-radius: 100px;
        margin-left: 0.5rem;
    }

        .admin-note::before {
            content: '';
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #b54708;
        }

    .post-title {
        font-family: var(--font-display);
        font-size: 1.3rem;
        line-height: 1.3;
        letter-spacing: -0.02em;
        color: var(--black);
        margin-bottom: 0.6rem;
    }

    .post-excerpt {
        font-size: 0.875rem;
        color: var(--gray-600);
        line-height: 1.65;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 4rem 0;
        color: var(--gray-400);
    }

        .empty-state .empty-title {
            font-family: var(--font-display);
            font-size: 1.5rem;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
            color: var(--gray-600);
        }

    @@media (max-width: 768px) {
        .posts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Header section -->
<div class="posts-header">
    <span class="posts-eyebrow">@(isAdmin ? "Admin" : "Community")</span>
    <h1>Posts</h1>
    <p>
        @if (isAdmin)
        {
            <text>
                You're viewing every post in the system — including drafts and
                private posts from other authors. Filter or sort to narrow it down.
            </text>
        }
        else
        {
            <text>
                Latest writing from across the community. Discover what other
                authors are publishing — search by title or filter by name.
            </text>
        }
    </p>
</div>

<div class="posts-toolbar">
    <span class="posts-count">
        @Model.Count post@(Model.Count != 1 ? "s" : "") @(hasFilters ? "found" : isAdmin ? "total" : "published")
        @if (isAdmin)
        {
            <span class="admin-note">Admin view — all statuses</span>
        }
    </span>
    <div class="toolbar-actions">
        <a asp-action="Mine" class="btn btn-secondary btn-sm">My blogs</a>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ New post</a>
    </div>
</div>

<!-- Filter bar -->
<form method="get" class="filter-bar" id="filter-form">
    <input type="text" name="title" value="@filterTitle" placeholder="Search title…" class="filter-input" />
    <input type="text" name="author" value="@filterAuthor" placeholder="Author…" class="filter-input" />
    <select name="sort" class="filter-select">
        <option value="" selected="@(string.IsNullOrEmpty(filterSort))">Sort: Newest</option>
        <option value="priority_desc" selected="@(filterSort == "priority_desc" || filterSort == "priority")">
            Sort: Priority — High to low
        </option>
        <option value="priority_asc" selected="@(filterSort == "priority_asc")">
            Sort: Priority — Low to high
        </option>
    </select>
    <button type="submit" class="btn btn-secondary btn-sm">Apply</button>
    @if (hasFilters)
    {
        <a asp-action="Index" class="btn btn-ghost btn-sm">Clear</a>
    }
</form>

@if (!Model.Any())
{
    if (hasFilters)
    {
        <div class="empty-state">
            <p class="empty-title">No posts match</p>
            <p style="font-size:0.875rem;margin-bottom:1.5rem">
                Try a different keyword or clear your filters.
            </p>
            <a asp-action="Index" class="btn btn-secondary">Clear filters</a>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p class="empty-title">Quiet around here</p>
            <p style="font-size:0.875rem;margin-bottom:1.5rem">
                Nobody has published anything yet. Be the first.
            </p>
            <a asp-action="Create" class="btn btn-primary">Write the first post</a>
        </div>
    }
}
else
{
    <div class="posts-grid">
        @foreach (var blog in Model)
        {
            var authorName = blog.User?.UserName ?? "Unknown";
            <a class="post-card" asp-action="Detail" asp-route-id="@blog.Id">
                <div class="post-card-header">
                    <div class="post-avatar">@Initials(authorName)</div>
                    <span class="post-meta">
                        <strong>@authorName</strong>
                        <span class="dot">·</span>
                        @RelativeTime(blog.CreatedAt)
                    </span>
                    @if (blog.Status == "DRAFT")
                    {
                        <span class="status-pill draft">Draft</span>
                    }
                    else if (blog.Status == "PRIVATE")
                    {
                        <span class="status-pill private">Private</span>
                    }
                    <span class="post-badge p@(blog.Priority)">P@(blog.Priority)</span>
                </div>
                <div class="post-title">@blog.Title</div>
                <p class="post-excerpt">@Excerpt(blog.Content)</p>
            </a>
        }
    </div>

    <script>
        (function () {
            const form = document.getElementById('filter-form');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const params = new URLSearchParams();
                new FormData(form).forEach((value, key) => {
                    if (value) params.append(key, value);
                });
                const query = params.toString();
                window.location.href = location.pathname + (query ? '?' + query : '');
            });
        })();
    </script>
}
