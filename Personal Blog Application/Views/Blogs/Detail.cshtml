@model Personal_Blog_Application.ViewModels.BlogDetailViewModel

@{
    var blog = Model.Blog;
    ViewData["Title"] = blog.Title;
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var canEdit = User.IsInRole("ADMIN") || blog.CreatedBy == userId;

    var from = Context.Request.Query["from"].ToString();
    var backAction = from == "mine" ? "Mine" : "Index";
    var backLabel = from == "mine" ? "Back to my posts" : "Back to posts";

    var authorName = blog.User?.UserName ?? "Unknown";

    string PriorityBadgeColors(int p) => p switch
    {
        5 => "bg-black text-white",
        4 => "bg-gray-800 text-white",
        _ => "bg-gray-100 text-gray-600"
    };
}

<style>
    /* Rendered Quill HTML (h2/h3/p/ul/ol/a/img/blockquote) — Tailwind base layer
       strips default heading + list styles, so we re-apply them within
       .post-content only, matching the original design. */
    .post-content { font-size: 1.05rem; line-height: 1.85; color: #262626; margin-bottom: 3rem; }
    .post-content h2 { font-family: 'DM Serif Display', Georgia, serif; font-size: 1.75rem; letter-spacing: -0.02em; margin: 2rem 0 1rem; }
    .post-content h3 { font-family: 'DM Serif Display', Georgia, serif; font-size: 1.35rem; letter-spacing: -0.02em; margin: 1.5rem 0 0.75rem; }
    .post-content p  { margin-bottom: 1rem; }
    .post-content ul, .post-content ol { margin: 0 0 1rem 1.5rem; list-style: revert; }
    .post-content ul li, .post-content ol li { margin-bottom: 0.35rem; }
    .post-content a  { color: #0a0a0a; text-decoration: underline; text-underline-offset: 2px; }
    .post-content img { max-width: 100%; height: auto; border-radius: 4px; margin: 1rem 0; }
    .post-content blockquote { border-left: 3px solid #d4d4d4; padding-left: 1.25rem; margin: 1.5rem 0; color: #525252; font-style: italic; }
</style>

<div class="mx-auto max-w-[760px]">

    <a asp-action="@backAction"
       class="mb-6 inline-block text-[0.825rem] text-gray-600 transition hover:-translate-x-0.5 hover:text-black">
        ← @backLabel
    </a>

    <div class="mb-6 flex items-center gap-[0.6rem] text-[0.85rem] text-gray-600">
        <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-gray-200 font-semibold text-[0.75rem] text-gray-600">@ViewHelpers.Initials(authorName)</div>
        <span>
            <strong class="font-medium text-black">@authorName</strong>
            <span class="mx-[0.35rem] text-gray-400">·</span>
            @ViewHelpers.RelativeTime(blog.CreatedAt)
            @if (blog.UpdatedAt.HasValue && blog.UpdatedAt.Value > blog.CreatedAt.AddMinutes(1))
            {
                <span class="mx-[0.35rem] text-gray-400">·</span>
                <span>edited @ViewHelpers.RelativeTime(blog.UpdatedAt.Value)</span>
            }
        </span>
    </div>

    <h1 class="font-display leading-[1.15] tracking-[-0.03em] mb-6 text-[clamp(2rem,4vw,3rem)] text-black">@blog.Title</h1>

    <div class="mb-8 flex flex-wrap gap-2">
        <span class="rounded-full px-[0.7rem] py-[0.3rem] font-medium text-[0.72rem] @PriorityBadgeColors(blog.Priority)">P@(blog.Priority)</span>
        @if (blog.Status == "DRAFT")
        {
            <span class="rounded-full bg-draft-bg px-[0.7rem] py-[0.3rem] font-medium text-[0.72rem] text-draft-text">Draft</span>
        }
        else if (blog.Status == "PRIVATE")
        {
            <span class="rounded-full bg-private-bg px-[0.7rem] py-[0.3rem] font-medium text-[0.72rem] text-private-text">Private</span>
        }
    </div>

    <article class="post-content">
        @Html.Raw(blog.Content)
    </article>

    <div class="flex flex-wrap items-center gap-2 border-t border-gray-200 pt-6">
        <span class="mr-auto text-[0.8rem] text-gray-400">
            Posted @blog.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy 'at' HH:mm")
        </span>

        @if (canEdit)
        {
            <a asp-action="Edit" asp-route-id="@blog.Id" asp-route-from="@from"
               class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-black no-underline transition hover:-translate-y-px hover:border-gray-400 hover:bg-gray-50 active:translate-y-0">
                Edit
            </a>
            <button type="button" id="open-delete"
                    class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-error px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-white transition hover:shadow-btn-danger-hover hover:-translate-y-px hover:opacity-90 active:translate-y-0">
                Delete
            </button>
        }
    </div>

    <partial name="_CommentSection" model="Model" />
</div>

@if (canEdit)
{
    <!-- Delete confirmation modal -->
    <div id="delete-modal"
         class="z-[1000] fixed inset-0 hidden items-center justify-center bg-black/45 p-4">
        <div class="w-full max-w-[440px] rounded-md bg-white p-8 shadow-[0_25px_60px_rgba(0,0,0,0.2)]">
            <h2 class="font-display mb-2 tracking-tight text-[1.35rem]">Delete this post?</h2>
            <p class="mb-6 text-sm leading-relaxed text-gray-600">
                "<strong>@blog.Title</strong>" will be permanently deleted. This action cannot be undone.
            </p>
            <div class="flex justify-end gap-2">
                <button type="button" id="cancel-delete"
                        class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-gray-600 transition hover:border-gray-300 hover:bg-gray-100 hover:text-black">Cancel</button>
                <form asp-action="Delete" asp-route-id="@blog.Id" asp-route-from="@from" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-error px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-white transition hover:opacity-90">Delete post</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const modal = document.getElementById('delete-modal');
            const openBtn = document.getElementById('open-delete');
            const cancelBtn = document.getElementById('cancel-delete');

            function openModal() {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
            function closeModal() {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }

            openBtn.addEventListener('click', openModal);
            cancelBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
            });
        })();
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
