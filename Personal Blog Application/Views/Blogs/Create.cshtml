@model Personal_Blog_Application.ViewModels.BlogCreateViewModel

@{
    ViewData["Title"] = "New Post";
}

<div class="mx-auto max-w-[760px]">

    <!-- Header -->
    <div class="mb-8">
        <a asp-action="Index"
           class="mb-4 inline-block text-[0.825rem] text-gray-600 transition hover:-translate-x-0.5 hover:text-black">
            ← Back to posts
        </a>
        <h1 class="font-display tracking-[-0.03em] text-[2rem]">New Post</h1>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- Title -->
        <div class="mb-6">
            <label asp-for="Title" class="mb-2 block font-medium tracking-[0.08em] text-[0.775rem] text-gray-600 uppercase">Title</label>
            <input asp-for="Title" placeholder="Enter your post title..."
                   class="h-12 w-full rounded border border-gray-200 bg-gray-50 px-4 font-sans text-[0.9rem] transition outline-none focus:border-black focus:bg-white" />
            <span asp-validation-for="Title" class="text-error mt-[0.35rem] block text-[0.775rem]"></span>
        </div>

        <!-- Priority -->
        <div class="mb-6">
            <label asp-for="Priority" class="mb-2 block font-medium tracking-[0.08em] text-[0.775rem] text-gray-600 uppercase">Priority</label>
            <select asp-for="Priority"
                    class="h-12 min-w-[160px] cursor-pointer rounded border border-gray-200 bg-gray-50 px-4 font-sans text-sm outline-none">
                <option value="1">P1 — Lowest</option>
                <option value="2">P2 — Low</option>
                <option value="3">P3 — Medium</option>
                <option value="4">P4 — High</option>
                <option value="5">P5 — Highest</option>
            </select>
            <span asp-validation-for="Priority" class="text-error mt-[0.35rem] block text-[0.775rem]"></span>
        </div>

        <!-- Content -->
        <div class="mb-8">
            <label asp-for="Content" class="mb-2 block font-medium tracking-[0.08em] text-[0.775rem] text-gray-600 uppercase">Content</label>
            <input type="hidden" asp-for="Content" id="Content" />
            <div id="quill-editor" class="mb-2"></div>
            <span asp-validation-for="Content" class="text-error mt-[0.35rem] block text-[0.775rem]"></span>
        </div>

        <!-- Hidden Status — set by buttons below -->
        <input type="hidden" asp-for="Status" id="Status" value="DRAFT" />

        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button type="button" id="btn-save-draft"
                    class="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-6 font-sans text-sm leading-none font-medium text-black transition hover:-translate-y-px hover:border-gray-400 hover:bg-gray-50 active:translate-y-0">
                Save draft
            </button>
            <button type="button" id="btn-save"
                    class="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-6 font-sans text-sm leading-none font-medium text-white transition hover:shadow-btn-primary-hover hover:-translate-y-px hover:opacity-90 active:translate-y-0">
                Save
            </button>
            <a asp-action="Mine"
               class="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-6 font-sans text-sm leading-none font-medium text-gray-600 no-underline transition hover:-translate-y-px hover:border-gray-300 hover:bg-gray-100 hover:text-black active:translate-y-0">
                Cancel
            </a>
        </div>
    </form>
</div>

<!-- Visibility modal -->
<div id="visibility-modal"
     class="fixed inset-0 z-[1000] hidden items-center justify-center bg-black/45 p-4">
    <div class="w-full max-w-[520px] rounded-md bg-white p-8 shadow-[0_25px_60px_rgba(0,0,0,0.2)]">
        <h2 class="font-display mb-[0.4rem] tracking-tight text-[1.4rem]">
            Who should see this post?
        </h2>
        <p class="mb-6 text-[0.85rem] text-gray-600">
            Choose a visibility option for your post.
        </p>

        <div class="mb-6 grid grid-cols-2 gap-3">
            <button type="button" data-status="PUBLISHED"
                    class="vis-option cursor-pointer rounded-md border border-gray-200 bg-white p-5 text-left transition hover:!border-black hover:!bg-gray-50 hover:-translate-y-0.5">
                <div class="mb-[0.4rem] flex items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <strong class="text-[0.9rem]">Published</strong>
                </div>
                <p class="m-0 leading-relaxed text-[0.775rem] text-gray-600">Visible to all signed-in users.</p>
            </button>

            <button type="button" data-status="PRIVATE"
                    class="vis-option cursor-pointer rounded-md border border-gray-200 bg-white p-5 text-left transition hover:!border-black hover:!bg-gray-50 hover:-translate-y-0.5">
                <div class="mb-[0.4rem] flex items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0110 0v4" />
                    </svg>
                    <strong class="text-[0.9rem]">Private</strong>
                </div>
                <p class="m-0 leading-relaxed text-[0.775rem] text-gray-600">Only visible to you.</p>
            </button>
        </div>

        <div class="flex justify-end gap-2">
            <button type="button" id="vis-cancel"
                    class="inline-flex h-[34px] cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans leading-none font-medium text-[0.8rem] text-gray-600 transition hover:border-gray-300 hover:bg-gray-100 hover:text-black">
                Cancel
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

    <style>
        /* Quill v2's internal DOM — target its built-in classes */
        .ql-toolbar {
            border: 1px solid #e8e8e8 !important;
            border-radius: 2px 2px 0 0 !important;
            font-family: 'DM Sans', system-ui, sans-serif !important;
        }
        .ql-container {
            border: 1px solid #e8e8e8 !important;
            border-top: none !important;
            border-radius: 0 0 2px 2px !important;
            font-family: 'DM Sans', system-ui, sans-serif !important;
            font-size: 15px !important;
        }
        .ql-editor {
            min-height: 320px;
            line-height: 1.75;
        }
        .ql-editor.ql-blank::before {
            color: #a0a0a0 !important;
            font-style: normal !important;
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        (function () {
            const hiddenContent = document.getElementById('Content');
            const form = hiddenContent.closest('form');

            const quill = new Quill('#quill-editor', {
                theme: 'snow',
                placeholder: 'Write your post content here...',
                modules: {
                    toolbar: [
                        [{ header: [2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        ['link', 'image'],
                        ['clean']
                    ]
                }
            });

            if (hiddenContent.value) {
                quill.clipboard.dangerouslyPasteHTML(hiddenContent.value);
            }

            function syncContent() {
                const isEmpty = quill.getText().trim().length === 0;
                hiddenContent.value = isEmpty ? '' : quill.root.innerHTML;
            }

            quill.on('text-change', syncContent);
            form.addEventListener('submit', syncContent);

            // ── Status / visibility flow ─────────────────────────────────
            const statusInput = document.getElementById('Status');
            const modal = document.getElementById('visibility-modal');

            function openModal() {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
            function closeModal() {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }

            function submitWithStatus(status) {
                statusInput.value = status;
                if (typeof form.requestSubmit === 'function') {
                    form.requestSubmit();
                } else {
                    form.submit();
                }
            }

            document.getElementById('btn-save-draft').addEventListener('click', function () {
                submitWithStatus('DRAFT');
            });

            document.getElementById('btn-save').addEventListener('click', function () {
                openModal();
            });

            document.getElementById('vis-cancel').addEventListener('click', closeModal);

            modal.addEventListener('click', function (e) {
                if (e.target === modal) closeModal();
            });

            document.querySelectorAll('.vis-option').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    submitWithStatus(btn.getAttribute('data-status'));
                });
            });
        })();
    </script>
}
