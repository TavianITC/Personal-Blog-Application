@model Personal_Blog_Application.ViewModels.BlogCreateViewModel

@{
    ViewData["Title"] = "New Post";
}

<div style="max-width:760px;margin:0 auto">

    <!-- Header -->
    <div style="margin-bottom:2rem">
        <a asp-action="Index"
           style="font-size:0.825rem;color:var(--gray-600);
                  text-decoration:none;display:inline-flex;
                  align-items:center;gap:0.35rem;margin-bottom:1rem">
            ← Back to posts
        </a>
        <h1 style="font-family:var(--font-display);font-size:2rem;
                   letter-spacing:-0.03em">New Post</h1>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- Title -->
        <div style="margin-bottom:1.5rem">
            <label asp-for="Title"
                   style="display:block;font-size:0.775rem;font-weight:500;
                          letter-spacing:0.08em;text-transform:uppercase;
                          color:var(--gray-600);margin-bottom:0.5rem">
                Title
            </label>
            <input asp-for="Title"
                   placeholder="Enter your post title..."
                   style="width:100%;height:48px;padding:0 1rem;
                          font-family:var(--font-body);font-size:0.9rem;
                          border:1px solid var(--gray-200);border-radius:2px;
                          outline:none;background:var(--gray-50);
                          transition:border-color 0.18s"
                   onfocus="this.style.borderColor='var(--black)';this.style.background='#fff'"
                   onblur="this.style.borderColor='var(--gray-200)';this.style.background='var(--gray-50)'" />
            <span asp-validation-for="Title"
                  style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
            </span>
        </div>

        <!-- Priority -->
        <div style="margin-bottom:1.5rem">
            <label asp-for="Priority"
                   style="display:block;font-size:0.775rem;font-weight:500;
                          letter-spacing:0.08em;text-transform:uppercase;
                          color:var(--gray-600);margin-bottom:0.5rem">
                Priority
            </label>
            <select asp-for="Priority"
                    style="height:48px;padding:0 1rem;min-width:160px;
                           font-family:var(--font-body);font-size:0.875rem;
                           border:1px solid var(--gray-200);border-radius:2px;
                           background:var(--gray-50);outline:none;cursor:pointer">
                <option value="1">P1 — Lowest</option>
                <option value="2">P2 — Low</option>
                <option value="3">P3 — Medium</option>
                <option value="4">P4 — High</option>
                <option value="5">P5 — Highest</option>
            </select>
            <span asp-validation-for="Priority"
                  style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
            </span>
        </div>

        <!-- Content -->
        <div style="margin-bottom:2rem">
            <label asp-for="Content"
                   style="display:block;font-size:0.775rem;font-weight:500;
                          letter-spacing:0.08em;text-transform:uppercase;
                          color:var(--gray-600);margin-bottom:0.5rem">
                Content
            </label>
            <textarea asp-for="Content" id="Content" rows="16"
                      style="width:100%;padding:1rem;font-size:0.9rem;
                             border:1px solid var(--gray-200);border-radius:2px;
                             font-family:var(--font-body);resize:vertical;display:none">
            </textarea>
            <div id="quill-editor" style="margin-bottom:0.5rem"></div>
            <span asp-validation-for="Content"
                  style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
            </span>
        </div>

        <!-- Actions -->
        <div style="display:flex;align-items:center;gap:0.75rem">
            <button type="submit"
                    style="height:46px;padding:0 1.5rem;background:var(--black);
                           color:#fff;font-family:var(--font-body);font-size:0.875rem;
                           font-weight:500;border:none;border-radius:2px;cursor:pointer">
                Publish post
            </button>
            <a asp-action="Index"
               style="height:46px;padding:0 1.25rem;display:inline-flex;
                      align-items:center;font-size:0.875rem;color:var(--gray-600);
                      border:1px solid var(--gray-200);border-radius:2px;
                      text-decoration:none">
                Cancel
            </a>
        </div>
    </form>
</div>

<!-- Quill -->
@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet" />

    <style>
        .ql-toolbar {
            border: 1px solid var(--gray-200) !important;
            border-radius: 2px 2px 0 0 !important;
            font-family: var(--font-body) !important;
        }

        .ql-container {
            border: 1px solid var(--gray-200) !important;
            border-top: none !important;
            border-radius: 0 0 2px 2px !important;
            font-family: var(--font-body) !important;
            font-size: 15px !important;
        }

        .ql-editor {
            min-height: 320px;
            line-height: 1.75;
        }

        .ql-editor.ql-blank::before {
            color: var(--gray-400) !important;
            font-style: normal !important;
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const quill = new Quill('#quill-editor', {
                theme: 'snow',
                placeholder: 'Write your post content here...',
                modules: {
                    toolbar: [
                        [{ header: [2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        ['link', 'image'],
                        ['clean']
                    ]
                }
            });

            // Load existing content if available
            const existing = document.getElementById('Content').value;
            if (existing) {
                quill.root.innerHTML = existing;
            }

            // Handle form submission
            document.querySelector('form').addEventListener('submit', function (e) {
                const delta = quill.getContents();
                const html = quill.root.innerHTML;
                const text = quill.getText().trim();

                console.log('Delta:', delta);
                console.log('HTML:', html);
                console.log('Text:', text);

                // Validation: check if content is not empty
                if (!text || text === '' || text.length === 0) {
                    e.preventDefault();
                    alert('Please write some content before publishing.');
                    return false;
                }

                // Set the textarea value to the HTML content
                document.getElementById('Content').value = html;
                console.log('Content set to:', document.getElementById('Content').value);
                return true;
            });
        });
    </script>
}