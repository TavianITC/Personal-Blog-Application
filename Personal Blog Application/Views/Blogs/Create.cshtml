@model Personal_Blog_Application.ViewModels.BlogCreateViewModel

@{
    ViewData["Title"] = "New Post";
}

<style>
    /* Visibility option cards in modal — extend with card-like hover */
    .vis-option {
        transition: border-color var(--transition), background var(--transition),
                    transform var(--transition);
    }

        .vis-option:hover {
            border-color: var(--black) !important;
            background: var(--gray-50) !important;
            transform: translateY(-2px);
        }
</style>


<div style="max-width:760px;margin:0 auto">

    <!-- Header -->
    <div style="margin-bottom:2rem">
        <a asp-action="Index" class="btn btn-link" style="margin-bottom:1rem">
            ← Back to posts
        </a>
        <h1 style="font-family:var(--font-display);font-size:2rem;
                   letter-spacing:-0.03em">New Post</h1>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- Title -->
        <div style="margin-bottom:1.5rem">
            <label asp-for="Title"
                   style="display:block;font-size:0.775rem;font-weight:500;
                          letter-spacing:0.08em;text-transform:uppercase;
                          color:var(--gray-600);margin-bottom:0.5rem">
                Title
            </label>
            <input asp-for="Title"
                   placeholder="Enter your post title..."
                   style="width:100%;height:48px;padding:0 1rem;
                          font-family:var(--font-body);font-size:0.9rem;
                          border:1px solid var(--gray-200);border-radius:2px;
                          outline:none;background:var(--gray-50);
                          transition:border-color 0.18s"
                   onfocus="this.style.borderColor='var(--black)';this.style.background='#fff'"
                   onblur="this.style.borderColor='var(--gray-200)';this.style.background='var(--gray-50)'" />
            <span asp-validation-for="Title"
                  style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
            </span>
        </div>

        <!-- Priority -->
        <div style="margin-bottom:1.5rem">
            <label asp-for="Priority"
                   style="display:block;font-size:0.775rem;font-weight:500;
                          letter-spacing:0.08em;text-transform:uppercase;
                          color:var(--gray-600);margin-bottom:0.5rem">
                Priority
            </label>
            <select asp-for="Priority"
                    style="height:48px;padding:0 1rem;min-width:160px;
                           font-family:var(--font-body);font-size:0.875rem;
                           border:1px solid var(--gray-200);border-radius:2px;
                           background:var(--gray-50);outline:none;cursor:pointer">
                <option value="1">P1 — Lowest</option>
                <option value="2">P2 — Low</option>
                <option value="3">P3 — Medium</option>
                <option value="4">P4 — High</option>
                <option value="5">P5 — Highest</option>
            </select>
            <span asp-validation-for="Priority"
                  style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
            </span>
        </div>

        <!-- Content -->
        <div style="margin-bottom:2rem">
            <label asp-for="Content"
                   style="display:block;font-size:0.775rem;font-weight:500;
                          letter-spacing:0.08em;text-transform:uppercase;
                          color:var(--gray-600);margin-bottom:0.5rem">
                Content
            </label>
            <input type="hidden" asp-for="Content" id="Content" />
            <div id="quill-editor" style="margin-bottom:0.5rem"></div>
            <span asp-validation-for="Content"
                  style="font-size:0.775rem;color:#c0392b;margin-top:0.35rem;display:block">
            </span>
        </div>

        <!-- Hidden Status — set by buttons below -->
        <input type="hidden" asp-for="Status" id="Status" value="DRAFT" />

        <!-- Actions -->
        <div style="display:flex;align-items:center;gap:0.75rem">
            <button type="button" id="btn-save-draft" class="btn btn-secondary btn-lg">
                Save draft
            </button>
            <button type="button" id="btn-save" class="btn btn-primary btn-lg">
                Save
            </button>
            <a asp-action="Index" class="btn btn-ghost btn-lg">Cancel</a>
        </div>
    </form>
</div>

<!-- Visibility modal -->
<div id="visibility-modal"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);
            z-index:1000;align-items:center;justify-content:center;padding:1rem">
    <div style="background:#fff;border-radius:6px;max-width:520px;width:100%;
                padding:2rem;box-shadow:0 25px 60px rgba(0,0,0,0.2)">
        <h2 style="font-family:var(--font-display);font-size:1.4rem;
                   letter-spacing:-0.02em;margin-bottom:0.4rem">
            Who should see this post?
        </h2>
        <p style="font-size:0.85rem;color:var(--gray-600);margin-bottom:1.5rem">
            Choose a visibility option for your post.
        </p>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:1.5rem">
            <button type="button" class="vis-option" data-status="PUBLISHED"
                    style="background:#fff;border:1px solid var(--gray-200);
                           border-radius:4px;padding:1.25rem;text-align:left;cursor:pointer;
                           transition:border-color 0.15s, background 0.15s">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.4rem">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <strong style="font-size:0.9rem">Published</strong>
                </div>
                <p style="font-size:0.775rem;color:var(--gray-600);margin:0;line-height:1.5">
                    Visible to all signed-in users.
                </p>
            </button>

            <button type="button" class="vis-option" data-status="PRIVATE"
                    style="background:#fff;border:1px solid var(--gray-200);
                           border-radius:4px;padding:1.25rem;text-align:left;cursor:pointer;
                           transition:border-color 0.15s, background 0.15s">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.4rem">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0110 0v4" />
                    </svg>
                    <strong style="font-size:0.9rem">Private</strong>
                </div>
                <p style="font-size:0.775rem;color:var(--gray-600);margin:0;line-height:1.5">
                    Only visible to you.
                </p>
            </button>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:0.5rem">
            <button type="button" id="vis-cancel" class="btn btn-ghost btn-sm">
                Cancel
            </button>
        </div>
    </div>
</div>

<!-- Quill -->
@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

    <style>
        .ql-toolbar {
            border: 1px solid var(--gray-200) !important;
            border-radius: 2px 2px 0 0 !important;
            font-family: var(--font-body) !important;
        }

        .ql-container {
            border: 1px solid var(--gray-200) !important;
            border-top: none !important;
            border-radius: 0 0 2px 2px !important;
            font-family: var(--font-body) !important;
            font-size: 15px !important;
        }

        .ql-editor {
            min-height: 320px;
            line-height: 1.75;
        }

            .ql-editor.ql-blank::before {
                color: var(--gray-400) !important;
                font-style: normal !important;
            }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        (function () {
            const hiddenContent = document.getElementById('Content');
            const form = hiddenContent.closest('form');

            const quill = new Quill('#quill-editor', {
                theme: 'snow',
                placeholder: 'Write your post content here...',
                modules: {
                    toolbar: [
                        [{ header: [2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        ['link', 'image'],
                        ['clean']
                    ]
                }
            });

            // Load existing content (Edit mode) — use Quill API, not innerHTML assignment
            if (hiddenContent.value) {
                quill.clipboard.dangerouslyPasteHTML(hiddenContent.value);
            }

            // Quill's empty state is still DOM "<p><br></p>" — normalize to "" for [Required]
            function syncContent() {
                const isEmpty = quill.getText().trim().length === 0;
                hiddenContent.value = isEmpty ? '' : quill.root.innerHTML;
            }

            // Keep hidden input in sync as user types (so jQuery unobtrusive validation sees the value)
            quill.on('text-change', syncContent);

            // Safety net: sync once more right before the form is submitted
            form.addEventListener('submit', syncContent);

            // ── Status / visibility flow ─────────────────────────────────
            const statusInput = document.getElementById('Status');
            const modal = document.getElementById('visibility-modal');

            function submitWithStatus(status) {
                statusInput.value = status;
                if (typeof form.requestSubmit === 'function') {
                    form.requestSubmit();          // triggers validation + submit
                } else {
                    form.submit();
                }
            }

            document.getElementById('btn-save-draft').addEventListener('click', function () {
                submitWithStatus('DRAFT');
            });

            document.getElementById('btn-save').addEventListener('click', function () {
                modal.style.display = 'flex';
            });

            document.getElementById('vis-cancel').addEventListener('click', function () {
                modal.style.display = 'none';
            });

            // Close on backdrop click
            modal.addEventListener('click', function (e) {
                if (e.target === modal) modal.style.display = 'none';
            });

            // Visibility option click → submit with chosen status (hover handled in CSS)
            document.querySelectorAll('.vis-option').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    submitWithStatus(btn.getAttribute('data-status'));
                });
            });
        })();
    </script>
}