@model Personal_Blog_Application.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Tavian Blog</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <style>
        /* Decorative SVG animations + pseudo-element backgrounds (kept as raw CSS
           because pure utility expressions for gradient + mask + keyframes get
           unreadable). All semantic/layout styling lives in utility classes. */

        .panel-left-decor::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
            -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
        }
        .panel-left-decor::after {
            content: '';
            position: absolute;
            top: 35%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(99,102,241,0.22) 0%, rgba(59,130,246,0.12) 40%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%      { opacity: 0.6; transform: scale(0.8); }
        }
        @@keyframes dashflow {
            from { stroke-dashoffset: 0; }
            to   { stroke-dashoffset: -120; }
        }
        @@keyframes ring-pulse {
            0%, 100% { opacity: 0.5; r: 5; }
            50%      { opacity: 1; r: 7; }
        }
        @@keyframes core-pulse {
            0%, 100% { opacity: 0.9; }
            50%      { opacity: 0.5; }
        }
        @@keyframes float-y {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-8px); }
        }

        .brand-dot       { animation: pulse-dot 3s ease-in-out infinite; }
        .dash-line       { stroke: rgba(99,102,241,0.25); stroke-width: 0.8; fill: none; stroke-dasharray: 4 8; animation: dashflow 8s linear infinite; }
        .dash-line-slow  { animation-duration: 14s; stroke: rgba(59,130,246,0.18); }
        .dash-line-fast  { animation-duration: 5s; stroke: rgba(139,92,246,0.2); }
        .node-ring       { fill: none; stroke-width: 0.8; animation: ring-pulse 4s ease-in-out infinite; }
        .node-core       { animation: core-pulse 4s ease-in-out infinite; }
        .float-card-anim { animation: float-y 7s ease-in-out infinite; }
    </style>
</head>
<body class="h-full bg-gray-50 font-sans text-black antialiased">
    <div class="grid min-h-screen grid-cols-1 md:grid-cols-2">

        <!-- ── Left panel ── -->
        <div class="panel-left-decor relative hidden flex-col justify-between overflow-hidden bg-[#0f1628] p-10 md:flex lg:p-12">

            <!-- Brand -->
            <a asp-controller="Home" asp-action="Index"
               class="font-display relative z-10 inline-flex items-center gap-2 tracking-tight text-[1.25rem] text-white no-underline">
                <span class="brand-dot h-[7px] inline-block w-[7px] rounded-full bg-[#6366f1] shadow-[0_0_8px_rgba(99,102,241,0.8)]"></span>
                Tavian Blog
            </a>

            <!-- SVG animated background lines -->
            <div class="z-[2] pointer-events-none absolute inset-0" aria-hidden="true">
                <svg class="h-full w-full" viewBox="0 0 500 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                    <path class="dash-line" d="M-20 200 Q120 100 260 180 T520 120" />
                    <path class="dash-line dash-line-slow" d="M-20 400 Q150 320 300 380 T540 340" />
                    <path class="dash-line dash-line-fast" d="M-20 600 Q100 520 240 560 T520 500" />
                    <path class="dash-line" d="M60 -10 Q80 200 120 350 T180 810" stroke-dasharray="3 10" />
                    <path class="dash-line dash-line-slow" d="M300 -10 Q320 150 340 320 T400 810" stroke-dasharray="3 10" />
                    <g>
                        <circle class="node-ring" cx="130" cy="180" r="6" stroke="rgba(99,102,241,0.4)" />
                        <circle class="node-core" cx="130" cy="180" r="2.5" fill="#6366f1" />
                    </g>
                    <g>
                        <circle class="node-ring" cx="310" cy="340" r="5" stroke="rgba(59,130,246,0.4)" style="animation-delay:1s" />
                        <circle class="node-core" cx="310" cy="340" r="2" fill="#3b82f6" style="animation-delay:1s" />
                    </g>
                    <g>
                        <circle class="node-ring" cx="80" cy="500" r="4" stroke="rgba(139,92,246,0.4)" style="animation-delay:2s" />
                        <circle class="node-core" cx="80" cy="500" r="1.8" fill="#8b5cf6" style="animation-delay:2s" />
                    </g>
                    <g>
                        <circle class="node-ring" cx="240" cy="620" r="6" stroke="rgba(99,102,241,0.35)" style="animation-delay:0.5s" />
                        <circle class="node-core" cx="240" cy="620" r="2.5" fill="#6366f1" style="animation-delay:0.5s" />
                    </g>
                    <line x1="130" y1="180" x2="310" y2="340" stroke="rgba(99,102,241,0.12)" stroke-width="0.7" />
                    <line x1="310" y1="340" x2="80" y2="500" stroke="rgba(59,130,246,0.1)" stroke-width="0.7" />
                    <line x1="80" y1="500" x2="240" y2="620" stroke="rgba(139,92,246,0.12)" stroke-width="0.7" />
                </svg>
            </div>

            <!-- Floating metric cards -->
            <div class="float-card-anim z-[6] absolute right-10 top-[28%] rounded-lg border border-white/10 bg-white/5 p-3 px-4 backdrop-blur-sm" aria-hidden="true">
                <div class="tracking-[0.1em] mb-1 uppercase text-[0.6rem] text-white/25">Posts today</div>
                <div class="font-display text-base tracking-tight text-white/85">24</div>
                <div class="h-[2px] mt-[0.4rem] rounded-sm bg-[rgba(99,102,241,0.6)]" style="width:68%"></div>
            </div>

            <div class="float-card-anim z-[6] absolute bottom-[28%] right-14 rounded-lg border border-white/10 bg-white/5 p-3 px-4 backdrop-blur-sm" style="animation-delay:3.5s" aria-hidden="true">
                <div class="tracking-[0.1em] mb-1 uppercase text-[0.6rem] text-white/25">Active writers</div>
                <div class="font-display text-base tracking-tight text-white/85">138</div>
                <div class="h-[2px] mt-[0.4rem] rounded-sm bg-[rgba(59,130,246,0.6)]" style="width:82%"></div>
            </div>

            <!-- Center content -->
            <div class="z-[5] relative flex flex-col gap-10">
                <h1 class="font-display leading-[1.15] tracking-[-0.03em] text-[clamp(1.75rem,3vw,2.75rem)] text-[#f1f5f9]">
                    Write your<br>
                    <em class="italic text-white/35">thoughts,</em><br>
                    share your voice.
                </h1>

                <!-- Stats -->
                <div class="flex gap-6">
                    <div class="flex flex-col gap-[0.2rem]">
                        <span class="font-display tracking-[-0.03em] text-[1.4rem] text-white">2k+</span>
                        <span class="tracking-[0.08em] uppercase text-[0.7rem] text-white/30">Posts</span>
                    </div>
                    <div class="w-px self-stretch bg-white/10"></div>
                    <div class="flex flex-col gap-[0.2rem]">
                        <span class="font-display tracking-[-0.03em] text-[1.4rem] text-white">500+</span>
                        <span class="tracking-[0.08em] uppercase text-[0.7rem] text-white/30">Writers</span>
                    </div>
                    <div class="w-px self-stretch bg-white/10"></div>
                    <div class="flex flex-col gap-[0.2rem]">
                        <span class="font-display tracking-[-0.03em] text-[1.4rem] text-white">98%</span>
                        <span class="tracking-[0.08em] uppercase text-[0.7rem] text-white/30">Uptime</span>
                    </div>
                </div>

                <!-- Feature pills -->
                <div class="flex flex-wrap gap-2">
                    <span class="inline-flex items-center gap-[0.4rem] rounded-full border border-white/10 bg-white/[0.03] px-3 py-[0.35rem] text-[0.72rem] text-white/50">
                        <span class="h-1 w-1 rounded-full bg-[#6366f1] opacity-80"></span>Rich-text editor
                    </span>
                    <span class="inline-flex items-center gap-[0.4rem] rounded-full border border-white/10 bg-white/[0.03] px-3 py-[0.35rem] text-[0.72rem] text-white/50">
                        <span class="h-1 w-1 rounded-full bg-[#6366f1] opacity-80"></span>Priority system
                    </span>
                    <span class="inline-flex items-center gap-[0.4rem] rounded-full border border-white/10 bg-white/[0.03] px-3 py-[0.35rem] text-[0.72rem] text-white/50">
                        <span class="h-1 w-1 rounded-full bg-[#6366f1] opacity-80"></span>Role-based access
                    </span>
                    <span class="inline-flex items-center gap-[0.4rem] rounded-full border border-white/10 bg-white/[0.03] px-3 py-[0.35rem] text-[0.72rem] text-white/50">
                        <span class="h-1 w-1 rounded-full bg-[#6366f1] opacity-80"></span>Search &amp; filter
                    </span>
                </div>
            </div>

            <p class="relative z-10 text-[0.725rem] text-white/20">© @DateTime.Now.Year Tavian Blog · ITC Group</p>
        </div>

        <!-- ── Right panel (form) ── -->
        <div class="flex items-center justify-center bg-white px-6 py-12 md:p-12">
            <div class="w-full max-w-[400px]">

                <h2 class="font-display tracking-[-0.03em] mb-2 text-[2rem]">Welcome back</h2>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="mb-4 rounded-r border-[#16a34a] border-l-[3px] bg-[#f0fdf4] px-4 py-3 text-[0.85rem] text-[#166534]">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <p class="mb-10 text-sm text-gray-600">
                    Don't have an account?
                    <a asp-controller="Auth" asp-action="Register"
                       class="font-medium text-black underline underline-offset-2">Create one</a>
                </p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 rounded-r border-error border-l-[3px] bg-danger-bg px-4 py-3">
                        <ul class="list-none leading-relaxed text-[0.825rem] text-error">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-5">
                        <label asp-for="Email" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Email</label>
                        <input asp-for="Email" type="email" placeholder="you@example.com"
                               class="h-12 w-full rounded border bg-gray-50 px-4 font-sans text-[0.9rem] @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "border-error" : "border-gray-200") text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
                        <span asp-validation-for="Email" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="Password" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Password</label>
                        <input asp-for="Password" type="password" placeholder="••••••••"
                               class="h-12 w-full rounded border bg-gray-50 px-4 font-sans text-[0.9rem] @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "border-error" : "border-gray-200") text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
                        <span asp-validation-for="Password" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
                    </div>

                    <div class="mb-7 flex items-center justify-between">
                        <label class="flex cursor-pointer select-none items-center gap-2 text-[0.85rem] text-gray-600">
                            <input asp-for="RememberMe" type="checkbox" class="h-4 w-4 cursor-pointer accent-black" />
                            Remember me
                        </label>
                        <a href="#" class="text-[0.825rem] text-gray-600 underline underline-offset-2 hover:text-black">Forgot password?</a>
                    </div>

                    <button type="submit"
                            class="h-[50px] tracking-[0.04em] w-full cursor-pointer rounded border-0 bg-black font-sans text-sm font-medium text-white transition hover:opacity-90 active:scale-[0.99]">
                        Sign in
                    </button>

                    <div class="tracking-[0.06em] my-6 flex items-center gap-4 text-[0.775rem] text-gray-400
                                before:content-[''] before:h-px before:flex-1 before:bg-gray-200
                                after:content-[''] after:h-px after:flex-1 after:bg-gray-200">or</div>

                    <p class="text-center text-[0.85rem] text-gray-600">
                        New here?
                        <a asp-controller="Auth" asp-action="Register"
                           class="font-medium text-black underline underline-offset-2">Create an account</a>
                    </p>
                </form>
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
