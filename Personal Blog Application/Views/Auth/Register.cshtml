@model Personal_Blog_Application.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Tavian Blog</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <style>
        /* Decorative animations + pseudo-element backgrounds — same approach as Login */

        .panel-left-decor::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.055) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(255,255,255,0.055) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
            -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
        }
        .panel-left-decor::after {
            content: '';
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(139,92,246,0.22) 0%, rgba(99,102,241,0.12) 40%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%      { opacity: 0.6; transform: scale(0.8); }
        }
        @@keyframes dashflow {
            from { stroke-dashoffset: 0; }
            to   { stroke-dashoffset: -120; }
        }
        @@keyframes ring-pulse {
            0%, 100% { opacity: 0.4; }
            50%      { opacity: 1; }
        }
        @@keyframes core-pulse {
            0%, 100% { opacity: 0.9; }
            50%      { opacity: 0.4; }
        }
        @@keyframes float-y {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-8px); }
        }

        .brand-dot       { animation: pulse-dot 3s ease-in-out infinite; }
        .dash-line       { stroke: rgba(139,92,246,0.2); stroke-width: 0.8; fill: none; stroke-dasharray: 4 8; animation: dashflow 10s linear infinite; }
        .dash-line-b     { stroke: rgba(99,102,241,0.18); animation-duration: 16s; }
        .dash-line-c     { stroke: rgba(59,130,246,0.15); animation-duration: 7s; }
        .node-ring       { fill: none; stroke-width: 0.8; animation: ring-pulse 4s ease-in-out infinite; }
        .node-core       { animation: core-pulse 4s ease-in-out infinite; }
        .float-card-anim { animation: float-y 7s ease-in-out infinite; }
    </style>
</head>
<body class="h-full bg-gray-50 font-sans text-black antialiased">
    <div class="grid min-h-screen grid-cols-1 md:grid-cols-2">

        <!-- ── Left panel ── -->
        <div class="panel-left-decor relative hidden flex-col justify-between overflow-hidden bg-[#0f1628] p-10 md:flex lg:p-12">

            <a asp-controller="Home" asp-action="Index"
               class="font-display relative z-10 inline-flex items-center gap-2 tracking-tight text-[1.25rem] text-white no-underline">
                <span class="brand-dot h-[7px] inline-block w-[7px] rounded-full bg-[#8b5cf6] shadow-[0_0_8px_rgba(139,92,246,0.8)]"></span>
                Tavian Blog
            </a>

            <!-- Animated SVG lines -->
            <div class="z-[2] pointer-events-none absolute inset-0" aria-hidden="true">
                <svg class="h-full w-full" viewBox="0 0 500 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                    <path class="dash-line" d="M-20 150 Q140 80 280 160 T540 100" />
                    <path class="dash-line dash-line-b" d="M-20 380 Q160 300 300 360 T540 310" />
                    <path class="dash-line dash-line-c" d="M-20 620 Q110 550 250 590 T540 540" />
                    <path class="dash-line" d="M100 -10 Q120 180 160 340 T220 810" stroke-dasharray="3 10" />
                    <path class="dash-line dash-line-b" d="M340 -10 Q360 160 380 330 T440 810" stroke-dasharray="3 10" />

                    <g>
                        <circle class="node-ring" cx="160" cy="160" r="6" stroke="rgba(139,92,246,0.45)" />
                        <circle class="node-core" cx="160" cy="160" r="2.5" fill="#8b5cf6" />
                    </g>
                    <g>
                        <circle class="node-ring" cx="290" cy="360" r="5" stroke="rgba(99,102,241,0.4)" style="animation-delay:1.2s" />
                        <circle class="node-core" cx="290" cy="360" r="2" fill="#6366f1" style="animation-delay:1.2s" />
                    </g>
                    <g>
                        <circle class="node-ring" cx="100" cy="530" r="4" stroke="rgba(59,130,246,0.4)" style="animation-delay:2.5s" />
                        <circle class="node-core" cx="100" cy="530" r="1.8" fill="#3b82f6" style="animation-delay:2.5s" />
                    </g>
                    <g>
                        <circle class="node-ring" cx="260" cy="640" r="5.5" stroke="rgba(139,92,246,0.35)" style="animation-delay:0.8s" />
                        <circle class="node-core" cx="260" cy="640" r="2.2" fill="#8b5cf6" style="animation-delay:0.8s" />
                    </g>

                    <line x1="160" y1="160" x2="290" y2="360" stroke="rgba(139,92,246,0.1)" stroke-width="0.7" />
                    <line x1="290" y1="360" x2="100" y2="530" stroke="rgba(99,102,241,0.1)" stroke-width="0.7" />
                    <line x1="100" y1="530" x2="260" y2="640" stroke="rgba(59,130,246,0.1)" stroke-width="0.7" />
                </svg>
            </div>

            <!-- Floating cards -->
            <div class="float-card-anim z-[6] absolute right-10 top-[26%] rounded-lg border border-white/10 bg-white/5 p-3 px-4 backdrop-blur-sm" style="animation-delay:1s" aria-hidden="true">
                <div class="tracking-[0.1em] mb-1 uppercase text-[0.6rem] text-white/25">New members</div>
                <div class="font-display text-base tracking-tight text-white/85">+12 today</div>
                <div class="h-[2px] mt-[0.4rem] rounded-sm bg-[rgba(139,92,246,0.6)]" style="width:55%"></div>
            </div>

            <div class="float-card-anim z-[6] absolute bottom-[26%] right-16 rounded-lg border border-white/10 bg-white/5 p-3 px-4 backdrop-blur-sm" style="animation-delay:4s" aria-hidden="true">
                <div class="tracking-[0.1em] mb-1 uppercase text-[0.6rem] text-white/25">Comments</div>
                <div class="font-display text-base tracking-tight text-white/85">340 this week</div>
                <div class="h-[2px] mt-[0.4rem] rounded-sm bg-[rgba(59,130,246,0.6)]" style="width:74%"></div>
            </div>

            <!-- Center content -->
            <div class="z-[5] relative flex flex-col gap-8">
                <h1 class="font-display leading-[1.15] tracking-[-0.03em] text-[clamp(1.75rem,3vw,2.75rem)] text-[#f1f5f9]">
                    Start writing<br>
                    <em class="italic text-white/35">your story</em><br>
                    today.
                </h1>

                <ul class="flex list-none flex-col gap-[0.7rem]">
                    @foreach (var item in new[] {
                        "Rich-text editor with full formatting",
                        "Organise posts by priority level",
                        "Comment and engage with community",
                        "Personal profile with avatar upload" })
                    {
                        <li class="flex items-center gap-[0.65rem] text-[0.825rem] text-white/45">
                            <span class="h-[18px] flex w-[18px] flex-shrink-0 items-center justify-center rounded-full border border-[rgba(139,92,246,0.4)] bg-[rgba(139,92,246,0.08)]">
                                <svg class="h-[9px] w-[9px] fill-none" stroke="rgba(139,92,246,0.9)" stroke-width="2" viewBox="0 0 10 10">
                                    <polyline points="1.5,5 4,7.5 8.5,2.5" />
                                </svg>
                            </span>
                            @item
                        </li>
                    }
                </ul>

                <div class="flex flex-wrap gap-2">
                    <span class="tracking-[0.06em] rounded-md border border-white/10 bg-white/[0.02] px-[0.6rem] py-1 font-medium uppercase text-[0.65rem] text-white/35">ASP.NET Core</span>
                    <span class="tracking-[0.06em] rounded-md border border-white/10 bg-white/[0.02] px-[0.6rem] py-1 font-medium uppercase text-[0.65rem] text-white/35">EF Core 8</span>
                    <span class="tracking-[0.06em] rounded-md border border-white/10 bg-white/[0.02] px-[0.6rem] py-1 font-medium uppercase text-[0.65rem] text-white/35">SQL Server</span>
                    <span class="tracking-[0.06em] rounded-md border border-white/10 bg-white/[0.02] px-[0.6rem] py-1 font-medium uppercase text-[0.65rem] text-white/35">.NET 8</span>
                </div>
            </div>

            <p class="relative z-10 text-[0.725rem] text-white/20">© @DateTime.Now.Year Tavian Blog · ITC Group</p>
        </div>

        <!-- ── Right panel (form) ── -->
        <div class="flex items-center justify-center overflow-y-auto bg-white px-6 py-12 md:p-12">
            <div class="w-full max-w-[400px]">

                <h2 class="font-display tracking-[-0.03em] mb-2 text-[2rem]">Create account</h2>
                <p class="mb-10 text-sm text-gray-600">
                    Already have one?
                    <a asp-controller="Auth" asp-action="Login"
                       class="font-medium text-black underline underline-offset-2">Sign in</a>
                </p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="mb-6 rounded-r border-error border-l-[3px] bg-danger-bg px-4 py-3">
                        <ul class="list-none leading-relaxed text-[0.825rem] text-error">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Register" asp-controller="Auth" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-[1.125rem]">
                        <label asp-for="Username" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Username</label>
                        <input asp-for="Username" type="text" placeholder="yourname" autocomplete="username"
                               class="h-12 w-full rounded border bg-gray-50 px-4 font-sans text-[0.9rem] @(ViewData.ModelState["Username"]?.Errors.Count > 0 ? "border-error" : "border-gray-200") text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
                        <span asp-validation-for="Username" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
                    </div>

                    <div class="mb-[1.125rem]">
                        <label asp-for="Email" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Email</label>
                        <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email"
                               class="h-12 w-full rounded border bg-gray-50 px-4 font-sans text-[0.9rem] @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "border-error" : "border-gray-200") text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
                        <span asp-validation-for="Email" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
                    </div>

                    <div class="mb-[1.125rem]">
                        <label asp-for="Password" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Password</label>
                        <input asp-for="Password" type="password" id="passwordInput" placeholder="Min. 6 characters" autocomplete="new-password"
                               class="h-12 w-full rounded border bg-gray-50 px-4 font-sans text-[0.9rem] @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "border-error" : "border-gray-200") text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
                        <div class="mt-2 flex gap-1">
                            <span id="s1" class="h-[3px] flex-1 rounded-sm bg-gray-200 transition-[background]"></span>
                            <span id="s2" class="h-[3px] flex-1 rounded-sm bg-gray-200 transition-[background]"></span>
                            <span id="s3" class="h-[3px] flex-1 rounded-sm bg-gray-200 transition-[background]"></span>
                            <span id="s4" class="h-[3px] flex-1 rounded-sm bg-gray-200 transition-[background]"></span>
                        </div>
                        <p id="strengthLabel" class="mt-[0.3rem] min-h-[1em] text-[0.725rem] text-gray-400"></p>
                        <span asp-validation-for="Password" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
                    </div>

                    <div class="mb-[1.125rem]">
                        <label asp-for="ConfirmPassword" class="tracking-[0.08em] mb-2 block font-medium uppercase text-[0.775rem] text-gray-600">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" placeholder="Repeat your password" autocomplete="new-password"
                               class="h-12 w-full rounded border bg-gray-50 px-4 font-sans text-[0.9rem] @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "border-error" : "border-gray-200") text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
                        <span asp-validation-for="ConfirmPassword" class="mt-[0.35rem] block text-[0.775rem] text-error"></span>
                    </div>

                    <button type="submit"
                            class="h-[50px] tracking-[0.04em] mt-2 w-full cursor-pointer rounded border-0 bg-black font-sans text-sm font-medium text-white transition hover:opacity-90 active:scale-[0.99]">
                        Create account
                    </button>

                    <p class="mt-5 text-center text-[0.825rem] text-gray-600">
                        Already have an account?
                        <a asp-controller="Auth" asp-action="Login"
                           class="font-medium text-black underline underline-offset-2">Sign in</a>
                    </p>
                </form>
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const input = document.getElementById('passwordInput');
        const bars = [document.getElementById('s1'), document.getElementById('s2'), document.getElementById('s3'), document.getElementById('s4')];
        const label = document.getElementById('strengthLabel');
        const colors = ['#e74c3c', '#e67e22', '#f1c40f', '#27ae60'];
        const labels = ['Weak', 'Fair', 'Good', 'Strong'];

        function getStrength(p) {
            let s = 0;
            if (p.length >= 6) s++;
            if (p.length >= 10) s++;
            if (/[A-Z]/.test(p) && /[0-9]/.test(p)) s++;
            if (/[^A-Za-z0-9]/.test(p)) s++;
            return Math.min(s, 4);
        }

        input && input.addEventListener('input', function () {
            const val = this.value;
            if (!val) { bars.forEach(b => b.style.background = ''); label.textContent = ''; return; }
            const s = getStrength(val);
            bars.forEach((b, i) => { b.style.background = i < s ? colors[s - 1] : '#e8e8e8'; });
            label.textContent = labels[s - 1] || '';
            label.style.color = colors[s - 1] || '#a0a0a0';
        });
    </script>
</body>
</html>
