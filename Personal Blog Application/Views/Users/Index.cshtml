@model List<Personal_Blog_Application.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "Users";
    var q = ViewBag.Query as string;
    var currentUserId = ViewBag.CurrentUserId as string;
    var hasQuery = !string.IsNullOrWhiteSpace(q);
}

<div class="mb-6">
    <span class="tracking-[0.1em] mb-[0.85rem] inline-flex items-center gap-[0.4rem] rounded-full bg-gray-100 px-[0.65rem] py-[0.3rem] font-medium uppercase text-[0.7rem] text-gray-600
                 before:content-[''] before:h-[5px] before:w-[5px] before:rounded-full before:bg-black">
        Admin
    </span>
    <h1 class="font-display tracking-[-0.03em] mb-[0.4rem] text-[clamp(2rem,4vw,2.75rem)]">Users</h1>
    <p class="m-0 mb-4 max-w-[540px] leading-relaxed text-[0.925rem] text-gray-600">
        Manage every account on the platform. Change roles, deactivate misbehaving
        users, or remove accounts entirely.
    </p>
</div>

<div class="mb-5 flex flex-wrap items-center justify-between gap-4">
    <span class="text-[0.85rem] text-gray-600">
        @Model.Count user@(Model.Count != 1 ? "s" : "") @(hasQuery ? "found" : "total")
    </span>
</div>

<!-- Search bar -->
<form method="get" id="filter-form" class="mb-6 flex flex-wrap items-center gap-2">
    <input type="text" name="q" value="@q" placeholder="Search by name or email…"
           class="h-[38px] flex-[1_1_280px] min-w-[280px] rounded border border-gray-200 bg-gray-50 px-[0.9rem] font-sans text-[0.85rem] text-black outline-none transition placeholder:text-gray-400 focus:border-black focus:bg-white" />
    <button type="submit"
            class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-black transition hover:-translate-y-px hover:border-gray-400 hover:bg-gray-50 active:translate-y-0">Search</button>
    @if (hasQuery)
    {
        <a asp-action="Index"
           class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-gray-600 no-underline transition hover:border-gray-300 hover:bg-gray-100 hover:text-black">Clear</a>
    }
</form>

@if (!Model.Any())
{
    <div class="py-16 text-center text-gray-400">
        @if (hasQuery)
        {
            <p class="font-display mb-2 text-2xl tracking-tight text-gray-600">No users match</p>
            <p class="mb-6 text-sm">Try a different keyword or clear your search.</p>
            <a asp-action="Index"
               class="h-[42px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-5 font-sans text-sm font-medium leading-none text-black no-underline transition hover:border-gray-400 hover:bg-gray-50">Clear search</a>
        }
        else
        {
            <p class="font-display mb-2 text-2xl tracking-tight text-gray-600">No users yet</p>
            <p class="text-sm">Once people register, you'll see them here.</p>
        }
    </div>
}
else
{
    <div class="overflow-hidden rounded-md border border-gray-200 bg-white">
        <table class="w-full border-collapse text-left">
            <thead class="bg-gray-50">
                <tr class="tracking-[0.05em] text-[0.7rem] font-medium uppercase text-gray-600">
                    <th class="px-5 py-3">User</th>
                    <th class="px-5 py-3">Role</th>
                    <th class="px-5 py-3">Status</th>
                    <th class="hidden px-5 py-3 md:table-cell">Posts</th>
                    <th class="px-5 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var isSelf = u.Id == currentUserId;
                    <tr class="border-t border-gray-200 transition hover:bg-gray-50">
                        <td class="px-5 py-4">
                            <div class="flex items-center gap-3">
                                <partial name="_Avatar" model="@(new Personal_Blog_Application.ViewModels.AvatarRenderViewModel { AvatarUrl = u.AvatarUrl, UserName = u.UserName, SizeClasses = "h-9 w-9", TextSize = "text-[0.75rem]" })" />
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-[0.9rem] text-black">@u.UserName</span>
                                        @if (isSelf)
                                        {
                                            <span class="rounded-full bg-gray-100 px-[0.55rem] py-[0.15rem] text-[0.65rem] text-gray-600">You</span>
                                        }
                                    </div>
                                    <div class="overflow-hidden text-ellipsis whitespace-nowrap text-[0.775rem] text-gray-600">@u.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-5 py-4">
                            @if (u.Role == "ADMIN")
                            {
                                <span class="inline-flex items-center rounded-full bg-black px-[0.6rem] py-[0.25rem] font-medium text-[0.7rem] text-white">ADMIN</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center rounded-full bg-gray-100 px-[0.6rem] py-[0.25rem] font-medium text-[0.7rem] text-gray-600">USER</span>
                            }
                        </td>
                        <td class="px-5 py-4">
                            @if (u.IsActive)
                            {
                                <span class="inline-flex items-center gap-[0.35rem] rounded-full bg-published-bg px-[0.6rem] py-[0.25rem] font-medium text-[0.7rem] text-published-text
                                             before:content-[''] before:h-[5px] before:w-[5px] before:rounded-full before:bg-published-text">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-[0.35rem] rounded-full bg-danger-bg px-[0.6rem] py-[0.25rem] font-medium text-[0.7rem] text-error
                                             before:content-[''] before:h-[5px] before:w-[5px] before:rounded-full before:bg-error">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td class="hidden px-5 py-4 text-[0.825rem] text-gray-600 md:table-cell">@u.BlogCount</td>
                        <td class="px-5 py-4">
                            <div class="flex justify-end gap-1">
                                <a asp-action="Edit" asp-route-id="@u.Id"
                                   class="h-[30px] inline-flex items-center rounded bg-transparent px-[0.55rem] text-[0.75rem] text-gray-600 no-underline transition hover:bg-gray-100 hover:text-black"
                                   title="Edit">
                                    <svg class="h-[14px] w-[14px] fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
                                    </svg>
                                    <span class="ml-1 hidden md:inline">Edit</span>
                                </a>
                                @if (!isSelf)
                                {
                                    <button type="button"
                                            class="js-delete h-[30px] font-[inherit] inline-flex cursor-pointer items-center rounded border-0 bg-transparent px-[0.55rem] text-[0.75rem] text-gray-600 transition hover:bg-danger-bg hover:text-error"
                                            data-id="@u.Id"
                                            data-name="@u.UserName"
                                            title="Delete">
                                        <svg class="h-[14px] w-[14px] fill-none stroke-current" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-2 14a2 2 0 01-2 2H9a2 2 0 01-2-2L5 6" />
                                            <path d="M10 11v6M14 11v6" />
                                            <path d="M9 6V4a2 2 0 012-2h2a2 2 0 012 2v2" />
                                        </svg>
                                        <span class="ml-1 hidden md:inline">Delete</span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Delete confirmation modal -->
    <div id="delete-modal"
         class="z-[1000] fixed inset-0 hidden items-center justify-center bg-black/45 p-4">
        <div class="w-full max-w-[440px] rounded-md bg-white p-8 shadow-[0_25px_60px_rgba(0,0,0,0.2)]">
            <h2 class="font-display mb-2 tracking-tight text-[1.35rem]">Delete this user?</h2>
            <p class="mb-6 text-sm leading-relaxed text-gray-600">
                "<strong id="delete-name"></strong>" and all their posts &amp; comments will be permanently deleted. This action cannot be undone.
            </p>
            <div class="flex justify-end gap-2">
                <button type="button" id="delete-cancel"
                        class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-gray-200 bg-transparent px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-gray-600 transition hover:border-gray-300 hover:bg-gray-100 hover:text-black">Cancel</button>
                <form id="delete-form" method="post" action="" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="h-[34px] inline-flex cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-error px-[0.9rem] font-sans font-medium leading-none text-[0.8rem] text-white transition hover:opacity-90">Delete user</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const modal = document.getElementById('delete-modal');
            const nameEl = document.getElementById('delete-name');
            const form = document.getElementById('delete-form');
            const cancelBtn = document.getElementById('delete-cancel');

            function openModal() { modal.classList.remove('hidden'); modal.classList.add('flex'); }
            function closeModal() { modal.classList.add('hidden'); modal.classList.remove('flex'); }

            document.querySelectorAll('.js-delete').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const id = btn.getAttribute('data-id');
                    const name = btn.getAttribute('data-name');
                    nameEl.textContent = name;
                    form.action = '@Url.Action("Delete", "Users")/' + id;
                    openModal();
                });
            });

            cancelBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
            });
        })();
    </script>
}
