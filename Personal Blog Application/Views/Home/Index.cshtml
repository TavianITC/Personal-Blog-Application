@model Personal_Blog_Application.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Mock-card stacking decoration on the guest hero. Hard to express purely
       via group-hover utilities since it targets first-child/last-child. */
    .mock-stack .mock-card:first-child { transform: translateY(-6px) rotate(-0.5deg); }
    .mock-stack .mock-card:last-child  { transform: translateY(4px) rotate(0.3deg); opacity: 0.65; }
    @@media (max-width: 768px) {
        .mock-stack .mock-card:first-child,
        .mock-stack .mock-card:last-child { transform: none; opacity: 1; }
    }
    /* Arrow inside .btn-primary slides on hover — easier with a class
       than with `group` since we want every button to behave the same. */
    .btn-primary-arrow .arrow { display: inline-block; font-style: normal; transition: transform 0.15s; }
    .btn-primary-arrow:hover .arrow { transform: translateX(3px); }
    /* CTA strip's circular accent ring (::before) — pseudo-element only. */
    .cta-strip-decor::before {
        content: '';
        position: absolute;
        right: -100px; top: -100px;
        width: 300px; height: 300px;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 50%;
    }
</style>

@if (User.Identity!.IsAuthenticated)
{
    <!-- ── Logged-in state ── -->
    <div class="pb-8 pt-16">
        <h1 class="font-display tracking-[-0.03em] mb-3 text-[clamp(2rem,4vw,3rem)]">
            Good to see you, @User.Identity.Name<em class="italic text-gray-400">.</em>
        </h1>
        <p class="mb-8 text-[0.95rem] text-gray-600">Ready to write something today?</p>
        <div class="flex flex-wrap gap-3">
            <a class="btn-primary-arrow inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-6 font-sans text-sm font-medium leading-none text-white no-underline transition hover:shadow-btn-primary-hover hover:-translate-y-px hover:opacity-90 active:translate-y-0"
               asp-controller="Blogs" asp-action="Create">
                New post <span class="arrow">→</span>
            </a>
            <a class="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-6 font-sans text-sm font-medium leading-none text-black no-underline transition hover:-translate-y-px hover:border-gray-400 hover:bg-gray-50 active:translate-y-0"
               asp-controller="Blogs" asp-action="Mine">
                View my blogs
            </a>
            @if (User.IsInRole("ADMIN"))
            {
                <a class="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-6 font-sans text-sm font-medium leading-none text-black no-underline transition hover:-translate-y-px hover:border-gray-400 hover:bg-gray-50 active:translate-y-0"
                   asp-controller="Users" asp-action="Index">
                    Manage users
                </a>
            }
        </div>
    </div>

    <hr class="my-12 border-0 border-t border-gray-200" />

    <!-- Published feed from other users -->
    <section class="pb-16 pt-8">
        <div class="mb-6 flex items-baseline justify-between">
            <p class="tracking-[0.1em] m-0 text-xs font-medium uppercase text-gray-400">Latest from the community</p>
            @if (Model.Feed.Any())
            {
                <span class="text-xs text-gray-400">
                    @Model.Feed.Count post@(Model.Feed.Count != 1 ? "s" : "")
                </span>
            }
        </div>

        @if (!Model.Feed.Any())
        {
            <div class="rounded-md border border-dashed border-gray-200 px-8 py-12 text-center text-gray-600">
                <p class="font-display mb-[0.4rem] text-[1.1rem] text-black">Quiet around here.</p>
                <p class="m-0 text-[0.85rem]">
                    No published posts from other writers yet — be the first to share something.
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                @foreach (var blog in Model.Feed)
                {
                    <partial name="_BlogCard"
                             model="blog"
                             view-data='new ViewDataDictionary(ViewData) {
                                 { "Compact", true },
                                 { "ShowStatusPill", false },
                                 { "ExcerptLength", 140 },
                                 { "From", "index" }
                             }' />
                }
            </div>
        }
    </section>
}
else
{
    <!-- ── Guest state ── -->
    <section class="grid grid-cols-1 items-center gap-16 py-20 md:grid-cols-2 md:py-20">
        <div class="order-2 md:order-1">
            <div class="tracking-[0.1em] mb-6 inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-[0.35rem] text-xs font-medium uppercase text-gray-600
                        before:content-[''] before:h-[6px] before:w-[6px] before:rounded-full before:bg-black">
                Blog Platform
            </div>
            <h1 class="font-display leading-[1.1] tracking-[-0.04em] mb-6 text-[clamp(2.5rem,5vw,4rem)] text-black">
                A space to<br>
                think out<br>
                <em class="italic text-gray-400">loud.</em>
            </h1>
            <p class="leading-[1.75] mb-10 max-w-[420px] text-base text-gray-600">
                Write clearly. Organise your ideas by priority.
                Share with your community. All in one minimal platform.
            </p>
            <div class="flex flex-wrap items-center gap-3">
                <a class="btn-primary-arrow inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-transparent bg-black px-6 font-sans text-sm font-medium leading-none text-white no-underline transition hover:shadow-btn-primary-hover hover:-translate-y-px hover:opacity-90 active:translate-y-0"
                   asp-controller="Auth" asp-action="Register">
                    Get started free <span class="arrow">→</span>
                </a>
                <a class="inline-flex h-12 cursor-pointer items-center justify-center gap-2 rounded border border-gray-300 bg-white px-6 font-sans text-sm font-medium leading-none text-black no-underline transition hover:-translate-y-px hover:border-gray-400 hover:bg-gray-50 active:translate-y-0"
                   asp-controller="Auth" asp-action="Login">
                    Sign in
                </a>
            </div>
        </div>

        <!-- Mock blog cards (decorative) -->
        <div class="mock-stack order-1 flex flex-col gap-3 md:order-2" aria-hidden="true">
            <div class="mock-card rounded-md border border-gray-200 bg-white px-6 py-5 transition hover:border-gray-400">
                <div class="mb-3 flex items-center justify-between">
                    <div class="flex h-7 w-7 items-center justify-center rounded-full bg-gray-200 font-medium text-[0.65rem] text-gray-600">JD</div>
                    <span class="ml-2 flex-1 text-[0.725rem] text-gray-400">Jane D. · 2h ago</span>
                    <span class="rounded-full bg-black px-2 py-[0.2rem] font-medium text-[0.65rem] text-white">P5</span>
                </div>
                <div class="font-display mb-[0.4rem] tracking-tight text-[0.95rem]">Getting started with ASP.NET Core MVC</div>
                <div class="leading-[1.6] overflow-hidden text-ellipsis whitespace-nowrap text-[0.775rem] text-gray-400">A complete guide to building your first MVC application from scratch...</div>
            </div>

            <div class="mock-card rounded-md border border-gray-200 bg-white px-6 py-5 transition hover:border-gray-400">
                <div class="mb-3 flex items-center justify-between">
                    <div class="flex h-7 w-7 items-center justify-center rounded-full bg-gray-200 font-medium text-[0.65rem] text-gray-600">MK</div>
                    <span class="ml-2 flex-1 text-[0.725rem] text-gray-400">Mike K. · 1d ago</span>
                    <span class="rounded-full bg-gray-100 px-2 py-[0.2rem] font-medium text-[0.65rem] text-gray-600">P3</span>
                </div>
                <div class="font-display mb-[0.4rem] tracking-tight text-[0.95rem]">Entity Framework Core — tips & tricks</div>
                <div class="leading-[1.6] overflow-hidden text-ellipsis whitespace-nowrap text-[0.775rem] text-gray-400">Improve your EF Core queries and avoid common performance pitfalls...</div>
            </div>

            <div class="mock-card rounded-md border border-gray-200 bg-white px-6 py-5 transition hover:border-gray-400">
                <div class="mb-3 flex items-center justify-between">
                    <div class="flex h-7 w-7 items-center justify-center rounded-full bg-gray-200 font-medium text-[0.65rem] text-gray-600">AL</div>
                    <span class="ml-2 flex-1 text-[0.725rem] text-gray-400">Amy L. · 3d ago</span>
                    <span class="rounded-full bg-gray-100 px-2 py-[0.2rem] font-medium text-[0.65rem] text-gray-600">P2</span>
                </div>
                <div class="font-display mb-[0.4rem] tracking-tight text-[0.95rem]">Clean architecture in .NET 8</div>
                <div class="leading-[1.6] overflow-hidden text-ellipsis whitespace-nowrap text-[0.775rem] text-gray-400">Structuring large applications using layered patterns...</div>
            </div>
        </div>
    </section>

    <hr class="border-0 border-t border-gray-200" />

    <!-- Features -->
    <section class="py-16">
        <p class="tracking-[0.1em] mb-10 text-xs font-medium uppercase text-gray-400">Everything you need</p>
        <div class="grid grid-cols-1 overflow-hidden rounded-md border border-gray-200 md:grid-cols-3">
            <div class="border-b border-gray-200 bg-white p-8 transition hover:bg-gray-50 md:border-b-0 md:border-r">
                <div class="mb-4 flex h-9 w-9 items-center justify-center rounded bg-black">
                    <svg class="h-4 w-4 fill-none stroke-white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                </div>
                <div class="font-display mb-2 text-base tracking-tight">Rich-text writing</div>
                <div class="leading-[1.65] text-[0.825rem] text-gray-600">TinyMCE editor with full formatting — headings, bold, lists, and inline images.</div>
            </div>
            <div class="border-b border-gray-200 bg-white p-8 transition hover:bg-gray-50 md:border-b-0 md:border-r">
                <div class="mb-4 flex h-9 w-9 items-center justify-center rounded bg-black">
                    <svg class="h-4 w-4 fill-none stroke-white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h11" /></svg>
                </div>
                <div class="font-display mb-2 text-base tracking-tight">Priority system</div>
                <div class="leading-[1.65] text-[0.825rem] text-gray-600">Tag every post 1–5. Sort your list by what matters most right now.</div>
            </div>
            <div class="bg-white p-8 transition hover:bg-gray-50">
                <div class="mb-4 flex h-9 w-9 items-center justify-center rounded bg-black">
                    <svg class="h-4 w-4 fill-none stroke-white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" /></svg>
                </div>
                <div class="font-display mb-2 text-base tracking-tight">Search &amp; filter</div>
                <div class="leading-[1.65] text-[0.825rem] text-gray-600">Find any post by keyword or filter by priority level instantly.</div>
            </div>
        </div>
    </section>

    <!-- CTA strip -->
    <div class="cta-strip-decor relative mb-16 flex flex-col items-start justify-between gap-8 overflow-hidden rounded-md bg-black p-12 md:flex-row md:items-center">
        <div>
            <h2 class="font-display tracking-[-0.03em] mb-[0.4rem] text-[1.75rem] text-white">Start writing today.</h2>
            <p class="m-0 text-[0.875rem] text-white/45">Free to join. No credit card required.</p>
        </div>
        <div class="z-[1] relative flex flex-shrink-0 flex-wrap gap-3">
            <a class="inline-flex h-11 items-center rounded bg-white px-5 font-sans font-medium text-black text-[0.85rem] no-underline transition hover:-translate-y-px hover:text-black hover:opacity-90 active:translate-y-0"
               asp-controller="Auth" asp-action="Register">Create account</a>
            <a class="inline-flex h-11 items-center rounded border border-white/15 bg-transparent px-5 font-sans text-white/70 text-[0.85rem] no-underline transition hover:-translate-y-px hover:border-white/35 hover:bg-white/5 hover:text-white active:translate-y-0"
               asp-controller="Auth" asp-action="Login">Sign in</a>
        </div>
    </div>
}
