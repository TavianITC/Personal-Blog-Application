@model Personal_Blog_Application.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Hero ── */
    .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
        padding: 5rem 0 4rem;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-600);
        background: var(--gray-100);
        padding: 0.35rem 0.75rem;
        border-radius: 100px;
        margin-bottom: 1.5rem;
    }

        .hero-eyebrow::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--black);
        }

    .hero-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 5vw, 4rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
        margin-bottom: 1.5rem;
        color: var(--black);
    }

        .hero-title em {
            font-style: italic;
            color: var(--gray-400);
        }

    .hero-desc {
        font-size: 1rem;
        line-height: 1.75;
        color: var(--gray-600);
        max-width: 420px;
        margin-bottom: 2.5rem;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    /* .btn-primary / .btn-secondary come from shared system in _Layout.cshtml */

    /* Arrow icon */
    .arrow {
        display: inline-block;
        font-style: normal;
        transition: transform 0.15s;
    }

    .btn-primary:hover .arrow {
        transform: translateX(3px);
    }

    /* ── Hero visual ── */
    .hero-visual {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .mock-card {
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        padding: 1.25rem 1.5rem;
        transition: border-color var(--transition);
    }

        .mock-card:hover {
            border-color: var(--gray-400);
        }

    .mock-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .mock-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--gray-200);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        font-weight: 500;
        color: var(--gray-600);
    }

    .mock-meta {
        font-size: 0.725rem;
        color: var(--gray-400);
        margin-left: 0.5rem;
        flex: 1;
    }

    .mock-badge {
        font-size: 0.65rem;
        font-weight: 500;
        padding: 0.2rem 0.5rem;
        border-radius: 100px;
        background: var(--gray-100);
        color: var(--gray-600);
    }

        .mock-badge.high {
            background: var(--black);
            color: var(--white);
        }

    .mock-title {
        font-family: var(--font-display);
        font-size: 0.95rem;
        letter-spacing: -0.01em;
        margin-bottom: 0.4rem;
    }

    .mock-excerpt {
        font-size: 0.775rem;
        color: var(--gray-400);
        line-height: 1.6;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Floating first card */
    .mock-card:first-child {
        transform: translateY(-6px) rotate(-0.5deg);
    }

    .mock-card:last-child {
        transform: translateY(4px) rotate(0.3deg);
        opacity: 0.65;
    }

    /* ── Divider ── */
    .section-divider {
        border: none;
        border-top: 1px solid var(--gray-200);
        margin: 0;
    }

    /* ── Features ── */
    .features {
        padding: 4rem 0;
    }

    .features-label {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-400);
        margin-bottom: 2.5rem;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    .feature-item {
        padding: 2rem;
        border-right: 1px solid var(--gray-200);
        background: var(--white);
        transition: background var(--transition);
    }

        .feature-item:last-child {
            border-right: none;
        }

        .feature-item:hover {
            background: var(--gray-50);
        }

    .feature-icon {
        width: 36px;
        height: 36px;
        background: var(--black);
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

        .feature-icon svg {
            width: 16px;
            height: 16px;
            stroke: var(--white);
            fill: none;
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .feature-title {
        font-family: var(--font-display);
        font-size: 1rem;
        letter-spacing: -0.01em;
        margin-bottom: 0.5rem;
    }

    .feature-desc {
        font-size: 0.825rem;
        color: var(--gray-600);
        line-height: 1.65;
    }

    /* ── CTA strip ── */
    .cta-strip {
        background: var(--black);
        border-radius: var(--radius-md);
        padding: 3rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        margin: 0 0 4rem;
        position: relative;
        overflow: hidden;
    }

        .cta-strip::before {
            content: '';
            position: absolute;
            right: -100px;
            top: -100px;
            width: 300px;
            height: 300px;
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 50%;
        }

    .cta-strip-text h2 {
        font-family: var(--font-display);
        font-size: 1.75rem;
        color: var(--white);
        letter-spacing: -0.03em;
        margin-bottom: 0.4rem;
    }

    .cta-strip-text p {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.45);
        margin: 0;
    }

    .cta-strip-actions {
        display: flex;
        gap: 0.75rem;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    /* Dark CTA-strip buttons — context-specific; named with cta- prefix
       to avoid colliding with the global .btn-ghost (light variant). */
    .cta-btn-light {
        display: inline-flex;
        align-items: center;
        height: 44px;
        padding: 0 1.25rem;
        background: var(--white);
        color: var(--black);
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: var(--radius);
        text-decoration: none;
        transition: opacity var(--transition), transform var(--transition);
    }

        .cta-btn-light:hover {
            opacity: 0.9;
            color: var(--black);
            transform: translateY(-1px);
        }

        .cta-btn-light:active {
            transform: translateY(0);
        }

    .cta-btn-outline {
        display: inline-flex;
        align-items: center;
        height: 44px;
        padding: 0 1.25rem;
        background: transparent;
        color: rgba(255,255,255,0.7);
        font-family: var(--font-body);
        font-size: 0.85rem;
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: var(--radius);
        text-decoration: none;
        transition: color var(--transition), border-color var(--transition),
                    background var(--transition), transform var(--transition);
    }

        .cta-btn-outline:hover {
            color: var(--white);
            border-color: rgba(255,255,255,0.35);
            background: rgba(255,255,255,0.05);
            transform: translateY(-1px);
        }

        .cta-btn-outline:active {
            transform: translateY(0);
        }

    /* ── Feed ── */
    .feed-section {
        padding: 2rem 0 4rem;
    }

    .feed-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .feed-label {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-400);
        margin: 0;
    }

    .feed-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .feed-card {
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        display: block;
        transition: border-color var(--transition), transform var(--transition);
    }

        .feed-card:hover {
            border-color: var(--gray-400);
            transform: translateY(-2px);
            color: inherit;
            text-decoration: none;
        }

    .feed-card-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.85rem;
    }

    .feed-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--gray-200);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-600);
        flex-shrink: 0;
    }

    .feed-meta {
        font-size: 0.75rem;
        color: var(--gray-600);
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .feed-meta strong {
            font-weight: 500;
            color: var(--black);
        }

    .feed-badge {
        font-size: 0.65rem;
        font-weight: 500;
        padding: 0.2rem 0.5rem;
        border-radius: 100px;
        background: var(--gray-100);
        color: var(--gray-600);
        flex-shrink: 0;
    }

        .feed-badge.p5, .feed-badge.p4 {
            background: var(--black);
            color: #fff;
        }

    .feed-comment-count {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.65rem;
        font-weight: 500;
        padding: 0.2rem 0.5rem;
        border-radius: 100px;
        background: var(--gray-100);
        color: var(--gray-600);
        flex-shrink: 0;
    }

        .feed-comment-count svg {
            width: 11px;
            height: 11px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .feed-title {
        font-family: var(--font-display);
        font-size: 1.05rem;
        line-height: 1.35;
        letter-spacing: -0.015em;
        margin-bottom: 0.45rem;
        color: var(--black);
    }

    .feed-excerpt {
        font-size: 0.825rem;
        color: var(--gray-600);
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
    }

    .feed-empty {
        border: 1px dashed var(--gray-200);
        border-radius: var(--radius-md);
        padding: 3rem 2rem;
        text-align: center;
        color: var(--gray-600);
    }

        .feed-empty .feed-empty-title {
            font-family: var(--font-display);
            font-size: 1.1rem;
            color: var(--black);
            margin-bottom: 0.4rem;
        }

    /* ── Logged-in welcome ── */
    .welcome-back {
        padding: 4rem 0 2rem;
    }

        .welcome-back h1 {
            font-family: var(--font-display);
            font-size: clamp(2rem, 4vw, 3rem);
            letter-spacing: -0.03em;
            margin-bottom: 0.75rem;
        }

        .welcome-back p {
            font-size: 0.95rem;
            color: var(--gray-600);
            margin-bottom: 2rem;
        }

    .quick-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .feed-grid {
            grid-template-columns: 1fr;
        }

        .hero {
            grid-template-columns: 1fr;
            padding: 3rem 0 2rem;
            gap: 2.5rem;
        }

        .hero-visual {
            order: -1;
        }

        .mock-card:first-child {
            transform: none;
        }

        .mock-card:last-child {
            transform: none;
            opacity: 1;
        }

        .features-grid {
            grid-template-columns: 1fr;
        }

        .feature-item {
            border-right: none;
            border-bottom: 1px solid var(--gray-200);
        }

            .feature-item:last-child {
                border-bottom: none;
            }

        .cta-strip {
            flex-direction: column;
            align-items: flex-start;
            padding: 2rem;
        }

        .cta-strip-actions {
            flex-wrap: wrap;
        }
    }
</style>

@if (User.Identity!.IsAuthenticated)
{
    <!-- ── Logged-in state ── -->
    <div class="welcome-back">
        <h1>Good to see you, @User.Identity.Name<em>.</em></h1>
        <p>Ready to write something today?</p>
        <div class="quick-actions">
            <a class="btn btn-primary btn-lg" asp-controller="Blogs" asp-action="Create">
                New post <span class="arrow">→</span>
            </a>
            <a class="btn btn-secondary btn-lg" asp-controller="Blogs" asp-action="Mine">
                View my blogs
            </a>
            @if (User.IsInRole("ADMIN"))
            {
                <a class="btn btn-secondary btn-lg" asp-controller="Users" asp-action="Index">
                    Manage users
                </a>
            }
        </div>
    </div>

    <hr class="section-divider" style="margin: 3rem 0" />

    <!-- Published feed from other users -->
    <section class="feed-section">
        <div class="feed-header">
            <p class="feed-label">Latest from the community</p>
            @if (Model.Feed.Any())
            {
                <span style="font-size:0.75rem;color:var(--gray-400)">
                    @Model.Feed.Count post@(Model.Feed.Count != 1 ? "s" : "")
                </span>
            }
        </div>

        @if (!Model.Feed.Any())
        {
            <div class="feed-empty">
                <p class="feed-empty-title">Quiet around here.</p>
                <p style="font-size:0.85rem;margin:0">
                    No published posts from other writers yet — be the first to share something.
                </p>
            </div>
        }
        else
        {
            <div class="feed-grid">
                @foreach (var blog in Model.Feed)
                {
                    var authorName = blog.User?.UserName ?? "Unknown";
                    var badgeClass = "feed-badge p" + blog.Priority;
                    <a class="feed-card" asp-controller="Blogs" asp-action="Detail" asp-route-id="@blog.Id">
                        <div class="feed-card-header">
                            <div class="feed-avatar">@ViewHelpers.Initials(authorName)</div>
                            <span class="feed-meta">
                                <strong>@authorName</strong>
                                <span style="color:var(--gray-400);margin:0 0.3rem">·</span>
                                @ViewHelpers.RelativeTime(blog.CreatedAt)
                            </span>
                            @if (blog.Comments.Count > 0)
                            {
                                <span class="feed-comment-count" title="@blog.Comments.Count comment@(blog.Comments.Count != 1 ? "s" : "")">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
                                    </svg>
                                    @blog.Comments.Count
                                </span>
                            }
                            <span class="@badgeClass">P@(blog.Priority)</span>
                        </div>
                        <div class="feed-title">@blog.Title</div>
                        <p class="feed-excerpt">@ViewHelpers.Excerpt(blog.Content, 140)</p>
                    </a>
                }
            </div>
        }
    </section>
}
else
{
    <!-- ── Guest state ── -->
    <section class="hero">
        <div class="hero-left">
            <div class="hero-eyebrow">Blog Platform</div>
            <h1 class="hero-title">
                A space to<br>
                think out<br>
                <em>loud.</em>
            </h1>
            <p class="hero-desc">
                Write clearly. Organise your ideas by priority.
                Share with your community. All in one minimal platform.
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Auth" asp-action="Register">
                    Get started free <span class="arrow">→</span>
                </a>
                <a class="btn btn-secondary btn-lg" asp-controller="Auth" asp-action="Login">
                    Sign in
                </a>
            </div>
        </div>

        <!-- Mock blog cards -->
        <div class="hero-visual" aria-hidden="true">
            <div class="mock-card">
                <div class="mock-card-header">
                    <div class="mock-avatar">JD</div>
                    <span class="mock-meta">Jane D. · 2h ago</span>
                    <span class="mock-badge high">P5</span>
                </div>
                <div class="mock-title">Getting started with ASP.NET Core MVC</div>
                <div class="mock-excerpt">A complete guide to building your first MVC application from scratch...</div>
            </div>

            <div class="mock-card">
                <div class="mock-card-header">
                    <div class="mock-avatar">MK</div>
                    <span class="mock-meta">Mike K. · 1d ago</span>
                    <span class="mock-badge">P3</span>
                </div>
                <div class="mock-title">Entity Framework Core — tips & tricks</div>
                <div class="mock-excerpt">Improve your EF Core queries and avoid common performance pitfalls...</div>
            </div>

            <div class="mock-card">
                <div class="mock-card-header">
                    <div class="mock-avatar">AL</div>
                    <span class="mock-meta">Amy L. · 3d ago</span>
                    <span class="mock-badge">P2</span>
                </div>
                <div class="mock-title">Clean architecture in .NET 8</div>
                <div class="mock-excerpt">Structuring large applications using layered patterns...</div>
            </div>
        </div>
    </section>

    <hr class="section-divider" />

    <!-- Features -->
    <section class="features">
        <p class="features-label">Everything you need</p>
        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                </div>
                <div class="feature-title">Rich-text writing</div>
                <div class="feature-desc">TinyMCE editor with full formatting — headings, bold, lists, and inline images.</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h11" /></svg>
                </div>
                <div class="feature-title">Priority system</div>
                <div class="feature-desc">Tag every post 1–5. Sort your list by what matters most right now.</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" /></svg>
                </div>
                <div class="feature-title">Search & filter</div>
                <div class="feature-desc">Find any post by keyword or filter by priority level instantly.</div>
            </div>
        </div>
    </section>

    <!-- CTA strip -->
    <div class="cta-strip">
        <div class="cta-strip-text">
            <h2>Start writing today.</h2>
            <p>Free to join. No credit card required.</p>
        </div>
        <div class="cta-strip-actions">
            <a class="cta-btn-light" asp-controller="Auth" asp-action="Register">Create account</a>
            <a class="cta-btn-outline" asp-controller="Auth" asp-action="Login">Sign in</a>
        </div>
    </div>
}
