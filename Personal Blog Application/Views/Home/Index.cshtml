@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Hero ── */
    .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
        padding: 5rem 0 4rem;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-600);
        background: var(--gray-100);
        padding: 0.35rem 0.75rem;
        border-radius: 100px;
        margin-bottom: 1.5rem;
    }

        .hero-eyebrow::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--black);
        }

    .hero-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 5vw, 4rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
        margin-bottom: 1.5rem;
        color: var(--black);
    }

        .hero-title em {
            font-style: italic;
            color: var(--gray-400);
        }

    .hero-desc {
        font-size: 1rem;
        line-height: 1.75;
        color: var(--gray-600);
        max-width: 420px;
        margin-bottom: 2.5rem;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        height: 48px;
        padding: 0 1.5rem;
        background: var(--black);
        color: var(--white);
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: var(--radius);
        text-decoration: none;
        transition: opacity var(--transition), transform var(--transition);
    }

        .btn-primary:hover {
            opacity: 0.85;
            color: var(--white);
        }

        .btn-primary:active {
            transform: scale(0.98);
        }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        height: 48px;
        padding: 0 1.5rem;
        background: var(--white);
        color: var(--black);
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 400;
        border: 1px solid var(--gray-300);
        border-radius: var(--radius);
        text-decoration: none;
        transition: background var(--transition), border-color var(--transition);
    }

        .btn-secondary:hover {
            background: var(--gray-100);
            color: var(--black);
            border-color: var(--gray-400);
        }

    /* Arrow icon */
    .arrow {
        display: inline-block;
        font-style: normal;
        transition: transform 0.15s;
    }

    .btn-primary:hover .arrow {
        transform: translateX(3px);
    }

    /* ── Hero visual ── */
    .hero-visual {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .mock-card {
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        padding: 1.25rem 1.5rem;
        transition: border-color var(--transition);
    }

        .mock-card:hover {
            border-color: var(--gray-400);
        }

    .mock-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .mock-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--gray-200);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        font-weight: 500;
        color: var(--gray-600);
    }

    .mock-meta {
        font-size: 0.725rem;
        color: var(--gray-400);
        margin-left: 0.5rem;
        flex: 1;
    }

    .mock-badge {
        font-size: 0.65rem;
        font-weight: 500;
        padding: 0.2rem 0.5rem;
        border-radius: 100px;
        background: var(--gray-100);
        color: var(--gray-600);
    }

        .mock-badge.high {
            background: var(--black);
            color: var(--white);
        }

    .mock-title {
        font-family: var(--font-display);
        font-size: 0.95rem;
        letter-spacing: -0.01em;
        margin-bottom: 0.4rem;
    }

    .mock-excerpt {
        font-size: 0.775rem;
        color: var(--gray-400);
        line-height: 1.6;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Floating first card */
    .mock-card:first-child {
        transform: translateY(-6px) rotate(-0.5deg);
    }

    .mock-card:last-child {
        transform: translateY(4px) rotate(0.3deg);
        opacity: 0.65;
    }

    /* ── Divider ── */
    .section-divider {
        border: none;
        border-top: 1px solid var(--gray-200);
        margin: 0;
    }

    /* ── Features ── */
    .features {
        padding: 4rem 0;
    }

    .features-label {
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-400);
        margin-bottom: 2.5rem;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    .feature-item {
        padding: 2rem;
        border-right: 1px solid var(--gray-200);
        background: var(--white);
        transition: background var(--transition);
    }

        .feature-item:last-child {
            border-right: none;
        }

        .feature-item:hover {
            background: var(--gray-50);
        }

    .feature-icon {
        width: 36px;
        height: 36px;
        background: var(--black);
        border-radius: var(--radius);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

        .feature-icon svg {
            width: 16px;
            height: 16px;
            stroke: var(--white);
            fill: none;
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .feature-title {
        font-family: var(--font-display);
        font-size: 1rem;
        letter-spacing: -0.01em;
        margin-bottom: 0.5rem;
    }

    .feature-desc {
        font-size: 0.825rem;
        color: var(--gray-600);
        line-height: 1.65;
    }

    /* ── CTA strip ── */
    .cta-strip {
        background: var(--black);
        border-radius: var(--radius-md);
        padding: 3rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        margin: 0 0 4rem;
        position: relative;
        overflow: hidden;
    }

        .cta-strip::before {
            content: '';
            position: absolute;
            right: -100px;
            top: -100px;
            width: 300px;
            height: 300px;
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 50%;
        }

    .cta-strip-text h2 {
        font-family: var(--font-display);
        font-size: 1.75rem;
        color: var(--white);
        letter-spacing: -0.03em;
        margin-bottom: 0.4rem;
    }

    .cta-strip-text p {
        font-size: 0.875rem;
        color: rgba(255,255,255,0.45);
        margin: 0;
    }

    .cta-strip-actions {
        display: flex;
        gap: 0.75rem;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    .btn-white {
        display: inline-flex;
        align-items: center;
        height: 44px;
        padding: 0 1.25rem;
        background: var(--white);
        color: var(--black);
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: var(--radius);
        text-decoration: none;
        transition: opacity var(--transition);
    }

        .btn-white:hover {
            opacity: 0.9;
            color: var(--black);
        }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        height: 44px;
        padding: 0 1.25rem;
        background: transparent;
        color: rgba(255,255,255,0.7);
        font-family: var(--font-body);
        font-size: 0.85rem;
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: var(--radius);
        text-decoration: none;
        transition: all var(--transition);
    }

        .btn-ghost:hover {
            color: var(--white);
            border-color: rgba(255,255,255,0.35);
        }

    /* ── Logged-in welcome ── */
    .welcome-back {
        padding: 4rem 0 2rem;
    }

        .welcome-back h1 {
            font-family: var(--font-display);
            font-size: clamp(2rem, 4vw, 3rem);
            letter-spacing: -0.03em;
            margin-bottom: 0.75rem;
        }

        .welcome-back p {
            font-size: 0.95rem;
            color: var(--gray-600);
            margin-bottom: 2rem;
        }

    .quick-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .hero {
            grid-template-columns: 1fr;
            padding: 3rem 0 2rem;
            gap: 2.5rem;
        }

        .hero-visual {
            order: -1;
        }

        .mock-card:first-child {
            transform: none;
        }

        .mock-card:last-child {
            transform: none;
            opacity: 1;
        }

        .features-grid {
            grid-template-columns: 1fr;
        }

        .feature-item {
            border-right: none;
            border-bottom: 1px solid var(--gray-200);
        }

            .feature-item:last-child {
                border-bottom: none;
            }

        .cta-strip {
            flex-direction: column;
            align-items: flex-start;
            padding: 2rem;
        }

        .cta-strip-actions {
            flex-wrap: wrap;
        }
    }
</style>

@if (User.Identity!.IsAuthenticated)
{
    <!-- ── Logged-in state ── -->
    <div class="welcome-back">
        <h1>Good to see you, @User.Identity.Name<em>.</em></h1>
        <p>Ready to write something today?</p>
        <div class="quick-actions">
            <a class="btn-primary" asp-controller="Blogs" asp-action="Create">
                New post <span class="arrow">→</span>
            </a>
            <a class="btn-secondary" asp-controller="Blogs" asp-action="Index">
                View my blogs
            </a>
            @if (User.IsInRole("ADMIN"))
            {
                <a class="btn-secondary" asp-controller="Users" asp-action="Index">
                    Manage users
                </a>
            }
        </div>
    </div>

    <hr class="section-divider" style="margin: 3rem 0" />

    <!-- Features reminder for logged-in -->
    <div class="features" style="padding-top:2rem">
        <p class="features-label">What you can do</p>
        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                </div>
                <div class="feature-title">Write & edit</div>
                <div class="feature-desc">Rich-text editor with headings, bold, and inline images.</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" /></svg>
                </div>
                <div class="feature-title">Comment</div>
                <div class="feature-desc">Engage with any post. Leave thoughts and get feedback.</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" /></svg>
                </div>
                <div class="feature-title">Profile</div>
                <div class="feature-desc">Upload an avatar and personalise your public profile.</div>
            </div>
        </div>
    </div>
}
else
{
    <!-- ── Guest state ── -->
    <section class="hero">
        <div class="hero-left">
            <div class="hero-eyebrow">Blog Platform</div>
            <h1 class="hero-title">
                A space to<br>
                think out<br>
                <em>loud.</em>
            </h1>
            <p class="hero-desc">
                Write clearly. Organise your ideas by priority.
                Share with your community. All in one minimal platform.
            </p>
            <div class="hero-actions">
                <a class="btn-primary" asp-controller="Auth" asp-action="Register">
                    Get started free <span class="arrow">→</span>
                </a>
                <a class="btn-secondary" asp-controller="Auth" asp-action="Login">
                    Sign in
                </a>
            </div>
        </div>

        <!-- Mock blog cards -->
        <div class="hero-visual" aria-hidden="true">
            <div class="mock-card">
                <div class="mock-card-header">
                    <div class="mock-avatar">JD</div>
                    <span class="mock-meta">Jane D. · 2h ago</span>
                    <span class="mock-badge high">P5</span>
                </div>
                <div class="mock-title">Getting started with ASP.NET Core MVC</div>
                <div class="mock-excerpt">A complete guide to building your first MVC application from scratch...</div>
            </div>

            <div class="mock-card">
                <div class="mock-card-header">
                    <div class="mock-avatar">MK</div>
                    <span class="mock-meta">Mike K. · 1d ago</span>
                    <span class="mock-badge">P3</span>
                </div>
                <div class="mock-title">Entity Framework Core — tips & tricks</div>
                <div class="mock-excerpt">Improve your EF Core queries and avoid common performance pitfalls...</div>
            </div>

            <div class="mock-card">
                <div class="mock-card-header">
                    <div class="mock-avatar">AL</div>
                    <span class="mock-meta">Amy L. · 3d ago</span>
                    <span class="mock-badge">P2</span>
                </div>
                <div class="mock-title">Clean architecture in .NET 8</div>
                <div class="mock-excerpt">Structuring large applications using layered patterns...</div>
            </div>
        </div>
    </section>

    <hr class="section-divider" />

    <!-- Features -->
    <section class="features">
        <p class="features-label">Everything you need</p>
        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
                </div>
                <div class="feature-title">Rich-text writing</div>
                <div class="feature-desc">TinyMCE editor with full formatting — headings, bold, lists, and inline images.</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h11" /></svg>
                </div>
                <div class="feature-title">Priority system</div>
                <div class="feature-desc">Tag every post 1–5. Sort your list by what matters most right now.</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" /></svg>
                </div>
                <div class="feature-title">Search & filter</div>
                <div class="feature-desc">Find any post by keyword or filter by priority level instantly.</div>
            </div>
        </div>
    </section>

    <!-- CTA strip -->
    <div class="cta-strip">
        <div class="cta-strip-text">
            <h2>Start writing today.</h2>
            <p>Free to join. No credit card required.</p>
        </div>
        <div class="cta-strip-actions">
            <a class="btn-white" asp-controller="Auth" asp-action="Register">Create account</a>
            <a class="btn-ghost" asp-controller="Auth" asp-action="Login">Sign in</a>
        </div>
    </div>
}
