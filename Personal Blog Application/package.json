{
  "name": "personal-blog-application",
  "version": "1.0.0",
  "description": "ASP.NET Core MVC blog app — Tailwind CSS pipeline",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i ./wwwroot/css/site.css -o ./wwwroot/css/output.css --minify",
    "css:watch": "tailwindcss -i ./wwwroot/css/site.css -o ./wwwroot/css/output.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  }
}
